# ─────────────────────────────────────────────────────────────
#  Dunst · Sigilo
#  Tarjetas oscuras con borde fino. El color del borde dice la
#  urgencia: apagado (baja), lila (normal), rojo (crítica).
#  Volumen y brillo salen como una tarjeta corta con barra.
# ─────────────────────────────────────────────────────────────

[global]
    monitor = 0
    follow = mouse
    origin = top-right
    offset = 16x76
    width = (280, 400)
    height = 260
    notification_limit = 4
    gap_size = 8
    scale = 0

    padding = 14
    horizontal_padding = 16
    text_icon_padding = 14
    frame_width = 1
    corner_radius = 12
    separator_height = 0
    transparency = 4

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 3
    progress_bar_min_width = 220
    progress_bar_max_width = 368

    font = JetBrainsMono Nerd Font 10
    line_height = 2
    markup = full
    format = "<span size='small' foreground='#8f7fb0'>%a</span>\n<b>%s</b>\n<span foreground='#b7c4bf'>%b</span>"
    alignment = left
    vertical_alignment = center
    ellipsize = end
    ignore_newline = no
    word_wrap = yes
    show_age_threshold = 60
    stack_duplicates = true
    hide_duplicate_count = false
    indicate_hidden = yes
    show_indicators = no
    sort = urgency_descending
    idle_threshold = 120

    icon_theme = "Sigilo, Papirus-Dark, Qogir-Dark"
    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 40
    max_icon_size = 48
    icon_corner_radius = 8

    sticky_history = yes
    history_length = 30
    browser = /usr/bin/xdg-open
    dmenu = /usr/bin/rofi -dmenu -p acción -theme ~/.config/rofi/sigilo-lista.rasi
    always_run_script = true
    title = Dunst
    class = Dunst
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#0c1210"
    foreground = "#94a3a0"
    frame_color = "#1f2b27"
    highlight = "#34d399"
    timeout = 4

[urgency_normal]
    background = "#0c1210"
    foreground = "#e7edea"
    frame_color = "#3a2f52"
    highlight = "#34d399"
    timeout = 7

[urgency_critical]
    background = "#140e10"
    foreground = "#f3eaea"
    frame_color = "#e0777d"
    highlight = "#e0777d"
    timeout = 0

# ── Tarjeta corta de volumen y brillo ────────────────────────
[osd]
    appname = osd
    format = "<b>%s</b>  <span foreground='#94a3a0'>%b</span>"
    frame_color = "#1f2b27"
    min_icon_size = 28
    max_icon_size = 28
    history_ignore = yes
    timeout = 1.4

[osd-volumen]
    appname = osd
    category = volumen
    highlight = "#b79ad4"

[osd-silencio]
    appname = osd
    category = silencio
    highlight = "#3a4a44"
    foreground = "#70837c"

[osd-brillo]
    appname = osd
    category = brillo
    highlight = "#3ee8a8"

# Capturas: la miniatura se ve mejor sin recortar
[captura]
    appname = captura
    max_icon_size = 96
