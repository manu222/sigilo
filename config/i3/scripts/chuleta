def leer():
    variables, secciones, sec, cur, modo = {}, [], "Otros", [], None
    for linea in open(CFG, encoding="utf-8"):
        linea = linea.rstrip("\n")
        if modo and re.match(r"^\s*}\s*$", linea):
            modo = None; continue
        m = re.match(r"^mode\s+(.+?)\s*\{\s*$", linea)
        if m:
            modo = "resize" if "resize" in m.group(1) else "sesion"; continue
        m = re.match(r"^set\s+(\$\S+)\s+(.+)$", linea)
        if m: variables[m.group(1)] = m.group(2).strip(); continue
        m = re.match(r"^#\s*\d+\.\s+(.+?)\s*$", linea)
        if m:
            if cur: secciones.append((sec, cur))
            sec, cur = m.group(1).strip(), []
            continue
        m = re.match(r"^\s*bindsym\s+((?:--\S+\s+)*)(\S+)\s+(.+?)\s*$", linea)
        if m and not modo:
            tecla = m.group(2)
            if "--border" in m.group(1):
                tecla += "+en el borde"
            cur.append((tecla, m.group(3)))
    if cur: secciones.append((sec, cur))
    return variables, secciones

SHELL = os.path.expanduser("~/.config/sigilo-shell.sh")

def leer_shell():
    """Saca los grupos de la función comandos() de sigilo-shell.sh."""
    grupos, nombre, filas, dentro = [], None, [], False
    try:
        lineas = open(SHELL, encoding="utf-8").read().splitlines()
    except OSError:
        return []
    for l in lineas:
        if l.startswith("comandos()"):
            dentro = True; continue
        if dentro and l.startswith("}"):
            break
        if not dentro:
            continue
        m = re.match(r'\s*_grupo\s+"([^"]+)"', l)
        if m:
            if nombre and filas: grupos.append((nombre, filas))
            nombre, filas = m.group(1), []
            continue
        m = re.match(r'\s*_fila\s+"((?:[^"\\]|\\.)*)"\s+"([^"]+)"', l)
        if m and nombre:
            filas.append((m.group(1).replace("\\\\", "\\"), m.group(2)))
    if nombre and filas: grupos.append((nombre, filas))
    return grupos

def expandir(t, v):
    for _ in range(3):
        for k in sorted(v, key=len, reverse=True):
            t = t.replace(k, v[k])
    return t

def k_bonita(t, v):
    partes = []
    for p in t.split("+"):
        if p == "en el borde":
            partes[-1] += " en el borde"; continue
        if p in TECLAS:            # $mod, Return, XF86...
            partes.append(TECLAS[p])
        elif p.startswith("$"):    # $left, $term... resueltas por el config
            partes.append(TECLAS.get(v.get(p, p), v.get(p, p)))
        else:
            partes.append(TECLAS.get(p, p))
    return " + ".join(partes)

def a_bonita(a, v):
    a = expandir(a, v)
    a = re.sub(r"\s*,\s*mode\s+\"default\"\s*$", "", a)
    limpio = re.sub(r"^exec\s+(--no-startup-id\s+)?", "", a).strip()
    for pat, txt in REGLAS:
        m = re.search(pat, limpio)
        if m: return txt(m) if callable(txt) else txt
    return limpio[:26]

# ── maquetacion ─────────────────────────────────────────────────────────────
ANCHO_COL = 44
SEP = 3

def pill(texto, color, ancho):
    t = " %s " % texto.upper()
    cuerpo = f(color) + "" + b(color) + f(OSCURO) + BOLD + t + RST + f(color) + "" + RST
    visible = len(t) + 2
    return cuerpo + " " * max(0, ancho - visible)

def fila(accion, tecla, ancho, color=MINT):
    libre = ancho - len(accion) - len(tecla)
    if libre < 2:
        accion = accion[:max(0, ancho - len(tecla) - 2)]
        libre = ancho - len(accion) - len(tecla)
    puntos = f(LINE) + "." * max(1, libre - 1) + RST
    return f(DIM) + accion + " " + puntos + " " + f(color) + tecla + RST

def bloque(nombre, binds, color, v):
    out = [pill(nombre, color, ANCHO_COL)]
    vistos = set()
    for t, a in binds:
        k, ac = k_bonita(t, v), a_bonita(a, v)
        if (k, ac) in vistos: continue
        vistos.add((k, ac))
        out.append(fila(ac, k, ANCHO_COL))
    out.append("")
    return out

LILA_C = (200, 170, 229)

def bloque_shell(nombre, filas):
    out = [pill("› " + nombre, VIOLET, ANCHO_COL)]
    for cmd, desc in filas:
        out.append(fila(desc[0].upper() + desc[1:], cmd, ANCHO_COL, LILA_C))
    out.append("")
    return out

# ── organización por tareas ─────────────────────────────────────────────────
# Cada acción va a una categoría. El orden de las categorías y de las filas
# dentro de cada una es el de esta lista: lo que más se usa, arriba.
CATEGORIAS = [
 ("Lo básico", MINT, [
    "Buscar un atajo", "Lanzador de apps", "Abrir terminal", "Terminal maximizado", "Navegador",
    "Gestor de archivos", "Buscar archivos", "Cerrar la ventana", "Esta chuleta",
    "Bloquear pantalla", "Menú de sesión"]),
 ("Cambiar de ventana", CYAN, [
    "Cambiar de ventana", "Ventana anterior", "Ver todas las ventanas",
    "Lista de ventanas", "Mover el foco", "Seleccionar el grupo", "Volver a la ventana"]),
 ("Colocar ventanas", SLATE, [
    "Pantalla completa", "Mover la ventana", "Soltar del mosaico",
    "Apartar (minimizar)", "Recuperar la apartada", "Centrar la flotante",
    "Modo redimensionar", "Siguiente ventana al lado", "Siguiente ventana debajo",
    "Apilar en pestañas", "Apilar en lista", "Volver al mosaico",
    "Menú de la ventana", "Matar ventana a ratón"]),
 ("Escritorios", VIOLET, [
    "Ir al escritorio", "Llevar la ventana a otro", "Escritorio anterior",
    "Escritorio siguiente", "Escritorio previo", "Cerrar el escritorio entero"]),
 ("Menús y utilidades", AMBER, [
    "Menú de utilidades", "Preguntar a la IA local", "Calculadora", "Emojis y símbolos",
    "Portapapeles", "Notificaciones", "Captura con selección", "Captura completa",
    "Redes wifi", "Bluetooth", "Fondos de pantalla", "Pausar el fondo animado"]),
 ("Sistema", RED, ["Recargar config", "Reiniciar i3"]),
 ("Teclas multimedia", OLIVE, [
    "Subir volumen", "Bajar volumen", "Silenciar", "Silenciar micro",
    "Subir brillo", "Bajar brillo", "Reproducir / pausa", "Pista siguiente", "Pista anterior"]),
]

FLECHAS = {"a la izquierda": "←", "abajo": "↓", "arriba": "↑", "a la derecha": "→"}


def recoger():
    """Lista única de (acción, teclas, orden i3) sin repeticiones.

    - Las acciones con varios atajos se juntan en una fila.
    - Foco y mover en cuatro direcciones pasan a una sola fila.
    - Los diez escritorios pasan a una fila «❖ + 1 … 0».
    """
    v, secciones = leer()
    acciones = {}          # desc -> {"teclas": [...], "cmd": str}
    orden = []
    for _, binds in secciones:
        for t, a in binds:
            k, d = k_bonita(t, v), a_bonita(a, v)
            cmd = expandir(a, v)
            m = re.match(r"^Foco (.+)$", d)
            if m and m[1] in FLECHAS:
                d, cmd = "Mover el foco", ""
                k = re.sub(r"[←→↑↓hjkl]$", "", k).rstrip(" +") + " + ← ↓ ↑ →"
                if "h" in t.split("+")[-1] or t.endswith(("$left", "$right", "$up", "$down")):
                    k = k.replace("← ↓ ↑ →", "h j k l")
            m = re.match(r"^Mover (a la izquierda|a la derecha|arriba|abajo)$", d)
            if m:
                d, cmd = "Mover la ventana", ""
                es_letra = t.endswith(("$left", "$right", "$up", "$down")) or t[-1] in "hjkl"
                k = re.sub(r" \+ [^+]+$", "", k) + (" + h j k l" if es_letra else " + ← ↓ ↑ →")
            m = re.match(r"^Ir al escritorio \d+$", d)
            if m:
                d, cmd, k = "Ir al escritorio", "", "❖ + 1 … 0"
            m = re.match(r"^Llevar al escritorio \d+$", d)
            if m:
                d, cmd, k = "Llevar la ventana a otro", "", "❖ + Shift + 1 … 0"
            if d not in acciones:
                acciones[d] = {"teclas": [], "cmd": cmd}
                orden.append(d)
            if k not in acciones[d]["teclas"]:
                acciones[d]["teclas"].append(k)
    return [(d, acciones[d]["teclas"], acciones[d]["cmd"]) for d in orden]


def clasificar(items):
    por_desc = {d: (t, c) for d, t, c in items}
    usados, grupos = set(), []
    for nombre, color, lista in CATEGORIAS:
        filas = []
        for d in lista:
            if d in por_desc:
                filas.append((d, por_desc[d][0], por_desc[d][1])); usados.add(d)
        if filas:
            grupos.append((nombre, color, filas))
    resto = [(d, t, c) for d, t, c in items if d not in usados]
    if resto:
        grupos.append(("Otros", DIM, resto))
    return grupos


def teclas_txt(teclas, maximo=2):
    """Junta hasta dos atajos: «❖ + Intro · ❖ + T»; si son flechas y hjkl,
    se quedan solo las flechas (las letras se explican en el pie)."""
    t = [x for x in teclas if not x.endswith("h j k l")] or teclas
    return " · ".join(t[:maximo])


def bloque_cat(nombre, color, filas):
    out = [pill(nombre, color, ANCHO_COL)]
    for d, teclas, _ in filas:
        k = teclas_txt(teclas)
        if len(d) + len(k) + 4 > ANCHO_COL:      # si no cabe, solo el primero
            k = teclas_txt(teclas, 1)
        out.append(fila(d, k, ANCHO_COL, color if color != DIM else MINT))
    out.append("")
    return out


def buscar():
    """Buscador: escribe lo que quieres hacer y Enter lo ejecuta."""
    import subprocess
    filas, acciones = [], []
    def esc(x): return html.escape(x, quote=False)
    hexa = lambda c: "#%02x%02x%02x" % c
    for nombre, color, grupo in clasificar(recoger()):
        for d, teclas, cmd in grupo:
            filas.append(f"<span foreground='{hexa(color)}'>●</span>  <b>{esc(d)}</b>"
                         f"   <span foreground='#94a3a0'>{esc(teclas_txt(teclas, 3))}</span>"
                         f"   <span foreground='#556760' size='small'>{esc(nombre.lower())}</span>")
            acciones.append(("i3", cmd))
    for nombre, grupo in leer_shell():
        for cmdt, desc in grupo:
            filas.append(f"<span foreground='#c8aae5'>●</span>  <b>{esc(desc[0].upper() + desc[1:])}</b>"
                         f"   <span foreground='#c8aae5'>{esc(cmdt)}</span>"
                         f"   <span foreground='#556760' size='small'>terminal · {esc(nombre)}</span>")
            acciones.append(("shell", cmdt))
    r = subprocess.run(
        ["rofi", "-dmenu", "-i", "-markup-rows", "-format", "i", "-p", "atajos",
         "-theme", os.path.expanduser("~/.config/rofi/sigilo-lista.rasi"),
         "-theme-str", 'window { width: 56em; } listview { lines: 12; } '
                       'textbox-sello { content: "❖"; text-color: #c8aae5; } '
                       'entry { placeholder: "¿qué quieres hacer? wifi, captura, escritorio…"; }',
         "-mesg", "<span foreground='#70837c'>Enter lo hace · los de la terminal se copian</span>"],
        input="\n".join(filas), capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip():
        return
    tipo, cmd = acciones[int(r.stdout.strip())]
    if tipo == "i3" and cmd:
        subprocess.Popen(["i3-msg", "-q", cmd])
    elif tipo == "shell":
        palabra = cmd.split()[0]
        subprocess.run(["xclip", "-selection", "clipboard"], input=palabra, text=True)
        subprocess.Popen(["notify-send", "-a", "Sigilo", "-i", "edit-copy",
                          "Copiado", f"«{palabra}»: pégalo en la terminal"])


def main():
    if "--buscar" in sys.argv:
        return buscar()
    bloques = [bloque_cat(n, c, filas) for n, c, filas in clasificar(recoger())]
    for nombre, filas in leer_shell():
        bloques.append(bloque_shell(nombre, filas))

    # Tantas columnas como quepan (mínimo 3). Los bloques van en orden de
    # lectura: de arriba abajo y de izquierda a derecha.
    ancho_term = shutil.get_terminal_size((160, 50)).columns
    NCOL = max(3, min(5, (ancho_term - 4 + SEP) // (ANCHO_COL + SEP)))
    total = sum(len(x) for x in bloques)
    objetivo, cols, actual, alto = total/NCOL, [], [], 0
    for bl in bloques:
        if actual and len(cols) < NCOL - 1 and alto + len(bl)*0.5 > objetivo:
            cols.append(actual); actual, alto = [], 0
        actual += bl; alto += len(bl)
    cols.append(actual)
    while len(cols) < NCOL: cols.append([])
    h = max(len(c) for c in cols)
    for c in cols: c += [""] * (h - len(c))

    cuerpo = []
    for r in range(h):
        trozos = []
        for c in cols:
            texto = c[r]
            visible = len(re.sub(r"\x1b\[[0-9;]*m", "", texto))
            trozos.append(texto + " " * max(0, ANCHO_COL - visible))
        cuerpo.append((" " * SEP).join(trozos).rstrip())

    tit, tw = titulo("ATAJOS")
    interior = ANCHO_COL*NCOL + SEP*(NCOL-1)
    pad = max(0, (interior - tw)//2)

    print()
    for l in tit:
        print("  " + " "*pad + l)
    sub = (f(MINT) + BOLD + "/" + RST + f(MUTE) + " buscar y lanzar   ·   ❖ = tecla Super   ·   "
           "las flechas también valen con h j k l   ·   " + f(LILA_C) + "lila" + f(MUTE)
           + " = comandos de la terminal   ·   otra tecla cierra")
    vis = len(re.sub(r"\x1b\[[0-9;]*m", "", sub))
    print("  " + " "*max(0,(interior-vis)//2) + f(MUTE) + sub + RST)
    print()
    print("  " + f(LINE) + "─"*interior + RST)
    print()
    for l in cuerpo:
        print("  " + l)

if __name__ == "__main__":
    main()
