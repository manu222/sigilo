#!/usr/bin/env bash
# Crea un proyecto de C++ con su estructura hecha.
#
#   extra/nuevo-proyecto calculadora     -> ~/Proyectos/ProyectosC++/calculadora
#   extra/nuevo-proyecto ./juego         -> donde estés, si le das una ruta
#   extra/nuevo-proyecto /tmp/pruebas/x  -> o una ruta entera
#
# Un nombre a secas va a la carpeta de proyectos de C++, que se crea sola la
# primera vez. Para llevarlos a otro sitio: SIGILO_PROYECTOS_CPP=~/otra-ruta
#
# Deja esto:
#
#   nombre/
#   ├── CMakeLists.txt        cómo se construye
#   ├── .gitignore            para que build/ no acabe en git
#   ├── .vscode/              para que F5 construya con CMake y no a mano
#   ├── include/nombre/       las cabeceras (.h)
#   │   └── saludo.h
#   └── src/                  el código (.cpp)
#       ├── main.cpp
#       └── saludo.cpp
#
# Viene con un .h y su .cpp ya enganchados, para que se vea cómo se reparte
# el código en varios ficheros sin tener que buscarlo.
#
# Por qué existe esto y no se usa «CMake: Quick Start» de VS Code: aquel deja
# solo un CMakeLists y un main.cpp en la raíz, y esta estructura es la que
# usa todo el mundo en cuanto el proyecto pasa de un fichero.
#
# Para Java no hay script: el Extension Pack for Java ya trae «Java: Create
# Java Project», que monta la estructura de Maven con sus arquetipos.

set -uo pipefail

ARG="${1:-}"
[ -n "$ARG" ] || { echo "Uso: nuevo-proyecto <nombre o ruta>"; exit 1; }

# Dónde van los proyectos de C++ cuando solo se da un nombre
BASE="${SIGILO_PROYECTOS_CPP:-$HOME/Proyectos/ProyectosC++}"

# Si lleva una barra o empieza por ~, es una ruta y se respeta tal cual. Si
# no, es solo un nombre y se guarda en la carpeta de siempre
case "$ARG" in
    */*|'~'*) RUTA="${ARG/#\~/$HOME}" ;;
    *)        RUTA="$BASE/$ARG" ;;
esac

[ -e "$RUTA" ] && { echo "Ya existe: $RUTA"; exit 1; }

NOMBRE=$(basename "$RUTA")

# Hacen falta dos nombres a partir del que hayas puesto, porque no valen las
# mismas letras en todos los sitios:
#
#   DESTINO  el objetivo de CMake y la carpeta de cabeceras. Admite guiones,
#            así que «prueba-cmake» se queda tal cual
#   ESPACIO  el espacio de nombres de C++. Un identificador no admite
#            guiones ni puede empezar por un número, así que «prueba-cmake»
#            pasa a ser «prueba_cmake». Sin esto, el código generado no
#            compila: el compilador lee «prueba - cmake» y se queja de que
#            «prueba» no existe
DESTINO=$(printf '%s' "$NOMBRE" | tr -c 'A-Za-z0-9_-' '_')
ESPACIO=$(printf '%s' "$NOMBRE" | tr -c 'A-Za-z0-9_' '_')
case "$ESPACIO" in [0-9]*) ESPACIO="_$ESPACIO" ;; esac

[ -d "$(dirname "$RUTA")" ] || echo "Creando $(dirname "$RUTA")"
mkdir -p "$RUTA/include/$DESTINO" "$RUTA/src"

cat > "$RUTA/CMakeLists.txt" <<CMAKE
cmake_minimum_required(VERSION 3.20)
project($DESTINO LANGUAGES CXX)

# C++20 y sin dejar que el compilador se invente extensiones propias: así el
# código compila igual aquí que en cualquier otro sitio
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

# Deja un compile_commands.json en build/ con la orden exacta de cada
# fichero. Es lo que lee el editor para saber dónde están tus cabeceras;
# sin esto, VS Code subraya en rojo los #include que sí existen
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

add_executable($DESTINO
    src/main.cpp
    src/saludo.cpp
)

# Con esto, en el código se escribe #include "$DESTINO/saludo.h" y CMake ya
# sabe que eso vive en include/
target_include_directories($DESTINO PRIVATE include)

# Avisos de sobra. La mayoría de los errores tontos de C++ los caza el
# compilador si se le deja hablar
target_compile_options($DESTINO PRIVATE -Wall -Wextra -Wpedantic)
CMAKE

cat > "$RUTA/.gitignore" <<'GIT'
# Todo lo que genera cmake al construir: se rehace solo, no va en git
build/
GIT

cat > "$RUTA/include/$DESTINO/saludo.h" <<CAB
#pragma once

#include <string>

// Una cabecera declara qué existe; el .cpp de al lado dice cómo se hace.
// Así otros ficheros pueden usar esto sin ver su código por dentro.
namespace $ESPACIO {

std::string saludo(const std::string& nombre);

}  // namespace $ESPACIO
CAB

cat > "$RUTA/src/saludo.cpp" <<IMPL
#include "$DESTINO/saludo.h"

namespace $ESPACIO {

std::string saludo(const std::string& nombre) {
    return "Hola, " + nombre + '!';
}

}  // namespace $ESPACIO
IMPL

cat > "$RUTA/src/main.cpp" <<MAIN
#include <iostream>

#include "$DESTINO/saludo.h"

int main() {
    std::cout << $ESPACIO::saludo("$NOMBRE") << '\n';
    return 0;
}
MAIN

# ── Ajustes de VS Code ───────────────────────────────────────────────────
# Sin esto, al darle a F5 el editor ofrece su tarea de «compilar el fichero
# activo», que compila un solo .cpp suelto, sin la carpeta include y sin los
# demás ficheros. En un proyecto de varios ficheros eso no compila nunca, y
# el error que sale no dice que hayas elegido mal: dice que no encuentra una
# cabecera. Dejando aquí la configuración, F5 construye con CMake y ya está.
mkdir -p "$RUTA/.vscode"

cat > "$RUTA/.vscode/settings.json" <<'AJUSTES'
{
    // Configura el proyecto al abrirlo, sin tener que pedirlo
    "cmake.configureOnOpen": true,
    // Y que el análisis del editor lea de ahí dónde están las cabeceras y
    // con qué opciones se compila cada fichero. Es lo que quita los
    // subrayados rojos en #include que sí existen
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json"
}
AJUSTES

cat > "$RUTA/.vscode/launch.json" <<'LANZAR'
{
    "version": "0.2.0",
    "configurations": [
        {
            // F5: construye con CMake y lanza el depurador sobre lo que salga.
            // «cmake.launchTargetPath» es el ejecutable que CMake acaba de
            // construir, sea cual sea su nombre, así que esto no hay que
            // tocarlo aunque el proyecto cambie de nombre
            "name": "Depurar",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Que gdb enseñe los vector y los string legibles",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
LANZAR

command -v git >/dev/null && git -C "$RUTA" init -q 2>/dev/null

echo "Proyecto $NOMBRE creado en $RUTA"
echo
echo "  code \"$RUTA\""
echo
echo "Al abrirlo, CMake Tools lo detecta solo y pide elegir compilador (GCC)."
echo "Construir y ejecutar están en la barra de abajo. A mano sería:"
echo "  cmake -S \"$RUTA\" -B \"$RUTA/build\" -G Ninja && cmake --build \"$RUTA/build\" && \"$RUTA/build/$DESTINO\""
