# Copias de seguridad y ficheros de trabajo
*.bak
*.bak-*
*.viejo
*.pre-fix
*.plano
*.sin-animaciones
*.log
*.vsix
# …salvo el del tema ya empaquetado, que se sube a propósito para poder
# llevárselo a un equipo suelto e instalarlo con doble clic
!vscode/sigilo-tema-*.vsix
__pycache__/
config/**/cache/

# Carpetas que crean las herramientas de escritorio y no pintan nada aquí
.vscode/

# Lo que elige cada equipo por su cuenta y no debe viajar en el repositorio:
# el sello puesto, si la tarjeta de música está encendida y el fondo actual.
# Si estos viajaran, al instalar en el otro equipo le pisarían su elección.
config/sigilo/sello-actual
config/sigilo/musica-escritorio-on
config/sigilo/musica-sin-barras
config/sigilo/fondo-actual

# Marca del modo prueba de Hyprland (ver config/hypr/scripts/vigilante)
config/hypr/prueba*
config/hypr/sin-atomic*
config/hypr/omitir*
