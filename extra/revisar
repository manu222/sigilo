#!/usr/bin/env bash
# Comprueba que ningún fichero del repositorio tenga errores de sintaxis.
#   ~/dotfiles/extra/revisar
# No cambia nada ni toca la configuración instalada: mira los ficheros del
# repositorio tal y como están, antes de que lleguen al otro equipo.
#
# No es lo mismo que «comprobar»: aquel revisa el sistema ya montado (que los
# programas estén, que los servicios corran, que los temas se apliquen) y lo
# hace sobre las copias de ~/.config. Este mira el código fuente y sirve para
# una cosa muy concreta: que una errata no viaje en un commit. Por eso lo
# lanza solo el hook de pre-commit (extra/hooks/pre-commit).

set -uo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO" || exit 1

ok()   { printf '  \e[32m✓\e[0m %s\n' "$*"; }
mal()  { printf '  \e[31m✗\e[0m %s\n' "$*"; FALLOS=$((FALLOS+1)); }
ojo()  { printf '  \e[33m!\e[0m %s\n' "$*"; }
paso() { printf '\n\e[1;36m── %s ──\e[0m\n' "$*"; }
# Cierra una sección: si no cayó nada se da por buena, y si cayó algo se dice
# cuántos fueron en vez de un visto bueno que ahí quedaría raro.
resumen() { local caidos=$(( FALLOS - $1 ))
    [ "$caidos" -eq 0 ] && ok "$2 ficheros revisados" \
        || printf '    %s ficheros revisados, %s con errores\n' "$2" "$caidos"; }
FALLOS=0

# Solo lo que está en el repositorio. Así no se revisan copias de seguridad,
# restos de __pycache__ ni ficheros a medio hacer que aún no se han añadido.
mapfile -t -d '' FICHEROS < <(git ls-files -z 2>/dev/null)
if [ "${#FICHEROS[@]}" -eq 0 ]; then
    echo "Esto no parece un clon de git, o está vacío."; exit 1
fi

# Cada fichero se clasifica por su primera línea y, si no tiene, por la
# extensión. Un script sin extensión (que aquí son casi todos) solo se puede
# reconocer por el shebang.
declare -a SHELL_ POSIX PY LUA DATOS
for f in "${FICHEROS[@]}"; do
    [ -f "$f" ] || continue
    primera=""
    if [ "$(head -c2 "$f" 2>/dev/null)" = '#!' ]; then primera="$(head -1 "$f")"; fi
    case "$primera" in
        *bash*)        SHELL_+=("$f"); continue ;;
        */bin/sh*)     POSIX+=("$f");  continue ;;
        *python*)      PY+=("$f");     continue ;;
    esac
    case "$f" in
        *.sh)                        SHELL_+=("$f") ;;
        *.py)                        PY+=("$f") ;;
        *.lua)                       LUA+=("$f") ;;
        *.json|*.jsonc|*.yaml|*.yml|*.toml) DATOS+=("$f") ;;
    esac
done

paso "Shell"
antes=$FALLOS
for f in "${SHELL_[@]}"; do
    salida="$(bash -n "$f" 2>&1)" || { mal "$f"; sed 's/^/      /' <<<"$salida" | head -5; }
done
for f in "${POSIX[@]}"; do
    salida="$(sh -n "$f" 2>&1)" || { mal "$f"; sed 's/^/      /' <<<"$salida" | head -5; }
done
resumen "$antes" "$(( ${#SHELL_[@]} + ${#POSIX[@]} ))"

paso "Python"
antes=$FALLOS
# ast.parse en vez de py_compile: hace la misma comprobación pero no deja
# carpetas __pycache__ tiradas por el repositorio.
for f in "${PY[@]}"; do
    salida="$(python3 -c 'import ast,sys; ast.parse(open(sys.argv[1],encoding="utf-8").read(), sys.argv[1])' "$f" 2>&1)" \
        || { mal "$f"; tail -3 <<<"$salida" | sed 's/^/      /'; }
done
resumen "$antes" "${#PY[@]}"

paso "Lua"
antes=$FALLOS
# La configuración de Hyprland es Lua. Hace falta el paquete «lua» para
# comprobarla; si no está, se avisa y se sigue, que en el Nitro no pinta nada.
if command -v luac >/dev/null; then
    for f in "${LUA[@]}"; do
        salida="$(luac -p "$f" 2>&1)" || { mal "$f"; sed 's/^/      /' <<<"$salida" | head -5; }
    done
    resumen "$antes" "${#LUA[@]}"
elif command -v lua >/dev/null; then
    for f in "${LUA[@]}"; do
        salida="$(lua -e 'assert(loadfile(arg[1]))' "$f" 2>&1)" || { mal "$f"; sed 's/^/      /' <<<"$salida" | head -5; }
    done
    resumen "$antes" "${#LUA[@]}"
else
    ojo "sin luac ni lua en este equipo: los ${#LUA[@]} ficheros de Hyprland se quedan sin revisar (pacman -S lua)"
fi

paso "Datos"
antes=$FALLOS
for f in "${DATOS[@]}"; do
    case "$f" in
        *.json|*.jsonc)
            # Varios de estos llevan comentarios con // y comas de más al
            # final de una lista: los admiten waybar, fastfetch y VS Code,
            # pero no el JSON de manual. Se quitan antes de mirar.
            salida="$(python3 - "$f" <<'PY' 2>&1
import json, re, sys
t = open(sys.argv[1], encoding="utf-8").read()
fuera, i, n = [], 0, len(t)
while i < n:
    c = t[i]
    if c == '"':                                  # una cadena se copia entera
        j = i + 1
        while j < n and (t[j] != '"' or t[j-1] == '\\'):
            j += 1
        fuera.append(t[i:j+1]); i = j + 1
    elif t.startswith("//", i):
        i = t.find("\n", i)
        if i < 0: break
    elif t.startswith("/*", i):
        i = t.find("*/", i)
        if i < 0: break
        i += 2
    else:
        fuera.append(c); i += 1
json.loads(re.sub(r",(\s*[}\]])", r"\1", "".join(fuera)))
PY
            )" || { mal "$f"; tail -2 <<<"$salida" | sed 's/^/      /'; } ;;
        *.yaml|*.yml)
            if python3 -c 'import yaml' 2>/dev/null; then
                salida="$(python3 -c 'import yaml,sys; yaml.safe_load(open(sys.argv[1],encoding="utf-8"))' "$f" 2>&1)" \
                    || { mal "$f"; tail -3 <<<"$salida" | sed 's/^/      /'; }
            else
                ojo "$f sin revisar: falta python-yaml"
            fi ;;
        *.toml)
            if python3 -c 'import tomllib' 2>/dev/null; then
                salida="$(python3 -c 'import tomllib,sys; tomllib.load(open(sys.argv[1],"rb"))' "$f" 2>&1)" \
                    || { mal "$f"; tail -3 <<<"$salida" | sed 's/^/      /'; }
            else
                ojo "$f sin revisar: este python no trae tomllib"
            fi ;;
    esac
done
resumen "$antes" "${#DATOS[@]}"

paso "Permisos"
# Un script que pierde el bit de ejecución no da error: simplemente no
# arranca, y encima en el otro equipo. Los de config/ los arregla instalar.sh
# al copiar, pero los de extra/ y sistema/ se lanzan desde el propio
# repositorio y dependen de lo que esté guardado en git.
sin_permiso=0
for f in "${FICHEROS[@]}"; do
    [ -f "$f" ] || continue
    [ "$(head -c2 "$f" 2>/dev/null)" = '#!' ] || continue
    [ -x "$f" ] && continue
    mal "$f no es ejecutable:  git update-index --chmod=+x $f"
    sin_permiso=$((sin_permiso+1))
done
[ "$sin_permiso" -eq 0 ] && ok "todos los scripts conservan el permiso de ejecución"

paso "Costumbres"
# Esto no son errores y no tumban el commit: son dos vicios que ya han dado
# problemas y que es mejor ver antes de que se multipliquen.

# 1. Rutas con el nombre de un usuario dentro. Funcionan en el equipo donde
#    se escribieron y en ninguno más, y en un repositorio público además
#    enseñan cómo te llamas
# Se miran solo las líneas que hacen algo: los ficheros de ejemplo que
# vienen con algunos programas traen rutas de su autor en comentarios
con_casa=$(grep -rnE '/home/[a-z][a-z0-9_-]*/' --exclude-dir=.git \
           --exclude-dir=__pycache__ --exclude='*.md' . 2>/dev/null \
           | grep -v '^./paquetes' \
           | awk -F: '{ linea=$0; sub(/^[^:]*:[0-9]*:/, "", linea)
                        if (linea !~ /^[[:space:]]*(#|\/\/|\*|--)/) print $1 }' \
           | sort -u)
if [ -n "$con_casa" ]; then
    ojo "$(printf '%s\n' "$con_casa" | wc -l) fichero(s) con rutas /home/<usuario> fijas:"
    printf '%s\n' "$con_casa" | sed 's|^\./|      |'
    printf '      \e[2muse ${env:HOME} en polybar, $HOME o ~ en los scripts\e[0m\n'
else
    ok "ninguna ruta /home/<usuario> escrita a mano"
fi

# 2. Ficheros temporales con nombre fijo. Cualquiera puede dejar antes un
#    enlace con ese nombre y hacer que al escribir te cargues otro fichero
con_tmp=$(grep -rnE '["> ]/tmp/[A-Za-z0-9_.-]+' --exclude-dir=.git \
          --exclude-dir=__pycache__ --exclude='*.md' . 2>/dev/null \
          | grep -vE 'mktemp|^\./paquetes|skippy-xd' | sort)
if [ -n "$con_tmp" ]; then
    ojo "$(printf '%s\n' "$con_tmp" | wc -l) ruta(s) fijas en /tmp (mejor mktemp):"
    printf '%s\n' "$con_tmp" | cut -d: -f1,2 | sed 's|^\./|      |'
else
    ok "ningún temporal con nombre fijo"
fi

echo
if [ "$FALLOS" -eq 0 ]; then
    printf '\e[1;32mTodo correcto.\e[0m\n'
else
    printf '\e[1;31m%s fallo(s).\e[0m\n' "$FALLOS"
fi
exit $(( FALLOS > 0 ? 1 : 0 ))
