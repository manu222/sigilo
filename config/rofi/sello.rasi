/* ─────────────────────────────────────────────────────────────
 * El sello que sale en la esquina de los menús.
 *
 * Este fichero lo reescribe ~/.config/i3/scripts/sello cada vez que se
 * cambia de sello (❖+Shift+G), para que el símbolo y su color vayan con
 * el que tengas puesto. Lo que hay aquí es el de partida, el clásico.
 * Los temas lo leen al final del todo, que en rofi es lo que manda.
 * ───────────────────────────────────────────────────────────── */
textbox-sello { content: "❖"; text-color: #3ee8a8; }
