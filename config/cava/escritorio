# cava para el visualizador grande del escritorio (i3/scripts/musica-escritorio).
# 48 barras con valores de 0 a 100; el dibujo lo hace el script, cava solo
# mide el sonido. Solo corre mientras suena algo.

[general]
bars = 48
framerate = 30
autosens = 1

[input]
method = pulse
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 100
bar_delimiter = 59
frame_delimiter = 10

[smoothing]
noise_reduction = 77
