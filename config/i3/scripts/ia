#!/usr/bin/env bash
# Pregunta rápida al modelo local: una caja de rofi para escribir y la
# respuesta en una ventana flotante donde se puede seguir la charla.
# Enter sin escribir nada abre la charla vacía.

modelo=$(curl -s --max-time 1 http://127.0.0.1:11434/api/tags \
         | grep -o '"name":"[^"]*"' | head -1 | cut -d'"' -f4)
[ -n "$SIGILO_MODELO" ] && modelo=$SIGILO_MODELO

if [ -z "$modelo" ]; then
    notify-send -a IA -i dialog-warning "IA local" "Ollama no responde o no tiene modelos."
    exit 1
fi

pregunta=$(rofi -dmenu -p "$modelo" \
    -theme ~/.config/rofi/sigilo-lista.rasi \
    -theme-str 'window { width: 44em; }
                listview { enabled: false; }
                textbox-sello { content: "󰙴"; text-color: #c8aae5; }
                entry { placeholder: "pregunta lo que quieras"; placeholder-color: #556760; }' \
    -mesg "<span foreground='#70837c'>Enter pregunta · Esc cancela · todo se queda en este equipo</span>" \
    -markup) || exit 0

exec ~/.config/i3/scripts/terminal --titulo "IA local" --tam 100x32 \
     -- ~/.config/i3/scripts/ia-chat "$pregunta"
