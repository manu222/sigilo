/* Sigilo Dark - menu de iconos en fila */
* {
    bg: #070b09;  surface: #15201c;  line: #26332e;
    fg: #e7edea;  fg-dim: #94a3a0;   accent-hi: #3ee8a8;  urgent: #e0777d;
    background-color: transparent;
    text-color: @fg-dim;
    font: "JetBrainsMono Nerd Font 11";
}
window {
    background-color: @bg;
    border: 1px;  border-color: @line;  border-radius: 16px;
    padding: 0;  width: 40em;
    location: center;  anchor: center;
}
mainbox { children: [ "inputbar", "listview" ]; padding: 1.4em; spacing: 1.2em; }
inputbar { children: [ "textbox-titulo" ]; }
textbox-titulo {
    content: " ";
    text-color: @fg-dim;
    horizontal-align: 0.5;
}
listview { columns: 5; lines: 1; spacing: 0.7em; scrollbar: false; fixed-height: true; }
element {
    orientation: vertical;
    padding: 1.2em 0.4em;
    border-radius: 12px;
    children: [ "element-text" ];
}
element-text {
    font: "JetBrainsMono Nerd Font 22";
    horizontal-align: 0.5;
    vertical-align: 0.5;
}
element normal.normal { text-color: @fg-dim; }
element selected.normal { background-color: @surface; text-color: @accent-hi; }
