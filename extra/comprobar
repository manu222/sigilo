#!/usr/bin/env bash
# Revisa que todas las piezas de Sigilo estén en su sitio y funcionando.
#   ~/dotfiles/extra/comprobar
# No cambia nada. Escribe un informe en pantalla y en ~/.cache/sigilo-comprobar.log

LOG=~/.cache/sigilo-comprobar.log
exec > >(tee "$LOG") 2>&1
C=~/.config
ok()   { printf '  \e[32m✓\e[0m %s\n' "$*"; }
mal()  { printf '  \e[31m✗\e[0m %s\n' "$*"; FALLOS=$((FALLOS+1)); }
ojo()  { printf '  \e[33m!\e[0m %s\n' "$*"; }
paso() { printf '\n\e[1;36m── %s ──\e[0m\n' "$*"; }
FALLOS=0

paso "Programas"
for p in i3 polybar rofi dunst picom skippy-xd greenclip kitty starship fastfetch eza bat fzf zoxide fd \
         brightnessctl pactl playerctl xclip xdotool notify-send dunstctl i3lock scrot magick feh \
         autotiling nmcli ollama timeshift btop jq nmap dig delta duf expac paccache gsimplecal \
         jgmenu imv mpv ffmpeg xwinwrap pipx dialog; do
    command -v "$p" >/dev/null && ok "$p" || mal "$p no está instalado"
done
python3 -c 'import i3ipc' 2>/dev/null && ok "python i3ipc" || mal "falta python-i3ipc"
for pl in calc emoji; do ls /usr/lib/rofi 2>/dev/null | grep -q "$pl" && ok "rofi-$pl" || mal "falta rofi-$pl"; done

paso "Temas"
[ -f ~/.local/share/icons/Sigilo/index.theme ] && ok "iconos Sigilo" || mal "iconos Sigilo sin generar: python3 ~/dotfiles/extra/iconos-sigilo.py"
if command -v code >/dev/null; then
    code --list-extensions 2>/dev/null | grep -qi "manu222.sigilo-tema" && ok "tema de VS Code" \
        || mal "tema de VS Code sin instalar: ~/dotfiles/vscode/instalar-tema"
fi
[ -d /usr/share/icons/Papirus ] && ok "Papirus" || mal "falta papirus-icon-theme"
[ -d /usr/share/themes/adw-gtk3-dark ] && ok "adw-gtk3" || mal "falta adw-gtk-theme"
ls /usr/share/icons 2>/dev/null | grep -qi bibata && ok "cursor Bibata" || mal "falta bibata-cursor-theme-bin"
fc-list | grep -qi "JetBrainsMono Nerd" && ok "fuente JetBrains Nerd" || mal "falta la fuente"
fc-list | grep -qi "Noto Color Emoji" && ok "emojis" || ojo "falta noto-fonts-emoji"
fc-list | grep -qi "Inter" && ok "fuente Inter" || ojo "falta inter-font (apps GTK)"

paso "Configuraciones"
i3 -C -c $C/i3/config >/tmp/i3c.txt 2>&1 && ok "i3: config válida" || { mal "i3: errores en el config"; sed 's/^/      /' /tmp/i3c.txt | head -20; }
for f in $C/i3/scripts/* $C/rofi/scripts/* $C/polybar/scripts/* $C/polybar/launch.sh; do
    [ -f "$f" ] || continue
    case "$(head -1 "$f")" in
        *python*) python3 -c "import ast,sys; ast.parse(open(sys.argv[1]).read())" "$f" 2>/dev/null && ok "${f#$C/}" || mal "${f#$C/}: error de sintaxis" ;;
        *bash*|*sh*) bash -n "$f" 2>/dev/null && ok "${f#$C/}" || mal "${f#$C/}: error de sintaxis" ;;
    esac
    [ -x "$f" ] || mal "${f#$C/}: no es ejecutable"
done | grep -v '✓' ; echo "  (scripts revisados)"
for t in $C/rofi/*.rasi; do
    rofi -theme "$t" -dump-theme >/dev/null 2>/tmp/rofit.txt && ok "rofi: ${t##*/}" || { mal "rofi: ${t##*/}"; head -3 /tmp/rofit.txt | sed 's/^/      /'; }
done
notify-send -a Sigilo "Comprobación" "Si ves esto, las notificaciones van" && ok "notificación de prueba enviada (debería verse arriba a la derecha)" || mal "notify-send falló"
starship print-config >/dev/null 2>&1 && ok "starship" || mal "starship: config con errores"
fastfetch -c $C/fastfetch/config.jsonc --pipe >/dev/null 2>/tmp/ff.txt && ! grep -qi error /tmp/ff.txt && ok "fastfetch" || { mal "fastfetch"; head -3 /tmp/ff.txt | sed 's/^/      /'; }

paso "Procesos en marcha"
for p in polybar dunst picom greenclip autotiling xss-lock; do pgrep -x "$p" >/dev/null && ok "$p" || mal "$p no está corriendo"; done
pgrep -f "skippy-xd --start-daemon" >/dev/null && ok "skippy-xd (Alt+Tab)" || mal "skippy-xd no está corriendo"
for s in botones-ventana escritorios app-enfocada; do pgrep -f "scripts/$s" >/dev/null && ok "$s" || mal "$s no está corriendo"; done
systemctl is-active -q ollama && ok "ollama" || ojo "ollama parado"
systemctl is-active -q cronie && ok "cronie (copias)" || mal "cronie parado"
systemctl is-active -q grub-btrfsd && ok "grub-btrfsd" || ojo "grub-btrfsd parado"

paso "Apps de la lista (iso/grupos.yaml)"
python3 - "$(dirname "$0")/../iso/grupos.yaml" <<'PY'
import sys, yaml, subprocess, shutil, os
os.environ["PATH"] = os.path.expanduser("~/.local/bin") + ":" + os.environ.get("PATH", "")
g = yaml.safe_load(open(sys.argv[1]))
inst = set(subprocess.run(["pacman", "-Qq"], capture_output=True, text=True).stdout.split())
faltan = []
for grupo in g:
    for s in (grupo.get("subgroups") or [grupo]):
        for p in s.get("packages", []):
            if p.startswith("pipx:"):
                if not shutil.which(p[5:].replace("-cli", "")) and not shutil.which(p[5:]):
                    faltan.append(p)
            elif not any(a in inst for a in p.split("|")):
                faltan.append(p)
print("  \033[32m✓\033[0m todas instaladas" if not faltan else "  \033[31m✗\033[0m faltan: " + " ".join(faltan))
PY

paso "Duplicados y restos"
for p in greenclip dunst picom polybar; do n=$(pgrep -xc "$p"); [ "$n" -le 1 ] && ok "$p: $n copia" || mal "$p: $n copias"; done
for s in botones-ventana escritorios app-enfocada fondo-vigia "ventanas vigilar" musica-escritorio alternador; do n=$(pgrep -fc "scripts/$s"); [ "$n" -le 1 ] && ok "$s: $n" || mal "$s: $n copias"; done
h=$(pacman -Qdtq 2>/dev/null | wc -l); [ "$h" -eq 0 ] && ok "sin paquetes huérfanos" || ojo "$h huérfanos (limpiar los quita): $(pacman -Qdtq | tr '\n' ' ')"
f=$(systemctl --failed --no-legend | wc -l); [ "$f" -eq 0 ] && ok "ningún servicio caído" || { mal "$f servicios caídos"; systemctl --failed --no-legend | sed 's/^/      /'; }
fu=$(systemctl --user --failed --no-legend | wc -l); [ "$fu" -eq 0 ] && ok "ningún servicio de usuario caído" || { mal "$fu servicios de usuario caídos"; systemctl --user --failed --no-legend | sed 's/^/      /'; }

paso "Menú y carpetas"
n=$(find ~/Aplicaciones -name '*.desktop' 2>/dev/null | wc -l); [ "$n" -gt 0 ] && ok "~/Aplicaciones: $n accesos" || mal "~/Aplicaciones vacía: ~/dotfiles/extra/organizar-apps"
rotos=$(find ~/Aplicaciones -xtype l 2>/dev/null | wc -l); [ "$rotos" -eq 0 ] && ok "sin accesos rotos" || mal "$rotos accesos rotos (vuelve a lanzar organizar-apps)"
[ -s ~/.config/jgmenu/sigilo.csv ] && ok "menú de la barra generado" || mal "falta ~/.config/jgmenu/sigilo.csv"
for d in ~/Seguridad ~/Proyectos; do [ -d "$d" ] && ok "$d" || mal "falta $d"; done

paso "Pantalla de inicio de sesión"
if [ -f /var/lib/sigilo/acceso.jpg ]; then
    ok "fondo de acceso en /var/lib/sigilo ($(date -r /var/lib/sigilo/acceso.jpg '+%d/%m %H:%M'))"
    grep -q "/var/lib/sigilo/acceso.jpg" /etc/lightdm/slick-greeter.conf && ok "slick-greeter lo usa" || mal "slick-greeter apunta a otro fondo: ~/dotfiles/sistema/instalar-acceso.sh"
else
    mal "sin fondo dinámico: lanza ~/dotfiles/sistema/instalar-acceso.sh"
fi

paso "Polybar: últimos errores"
# Solo lo del último arranque de la barra, no el historial entero
awk '/lanzamiento/{b=""} {b=b $0 "\n"} END{printf "%s", b}' ~/.cache/polybar.log 2>/dev/null \
    | grep -iE "error|warn" | grep -v "Root pixmap" | tail -8 | sed 's/^/  /' | grep . || ok "sin errores"
# Caídas de la barra de hoy (las levanta launch.sh, pero conviene saberlo)
c=$(awk -v hoy="$(date +%F)" 'index($0, hoy) {h=1} h' ~/.cache/polybar.log 2>/dev/null | grep -c "se cayó\|Assertion")
[ "${c:-0}" -eq 0 ] && ok "la barra no se ha caído" || ojo "la barra se ha caído $c veces hoy (ver ~/.cache/polybar.log); launch.sh la vuelve a levantar"

paso "Sonido"
s=$(pactl get-default-sink 2>/dev/null)
case "$s" in
    ""|auto_null|"(null)") mal "sin salida de sonido real: systemctl --user restart wireplumber pipewire pipewire-pulse" ;;
    # Se lee la salida de texto de pactl: su JSON pone «(null)» en los nombres con tildes
    *) ok "sale por $(LC_ALL=C pactl list sinks | awk -v s="$s" '$1=="Name:"{n=$2} $1=="Description:" && n==s {sub(/^[ \t]*Description: /,""); print; exit}')" ;;
esac

paso "Resumen"
[ $FALLOS -eq 0 ] && echo "  Todo en orden." || echo "  $FALLOS cosas que revisar. Informe en $LOG"
