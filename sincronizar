#!/usr/bin/env bash
# Copia la configuración viva de ~/.config al repositorio.
#
# Se usan copias y no enlaces simbólicos a propósito: algunos programas
# (xfce4-terminal, btop) reescriben su fichero entero al guardar ajustes, y
# eso convierte un enlace en un fichero normal sin avisar. Con copias, el
# repositorio nunca se rompe solo; el precio es acordarse de ejecutar esto.

set -uo pipefail
REPO="$(cd "$(dirname "$0")" && pwd)"
ORIGEN="$HOME/.config"
DESTINO="$REPO/config"

# Qué se guarda. Rutas relativas a ~/.config
PIEZAS=(
    i3
    polybar
    rofi
    dunst/dunstrc
    picom.conf
    starship.toml
    sigilo-shell.sh
    fastfetch
    btop/btop.conf
    btop/themes
    bat/themes
    gtk-3.0/settings.ini
    gtk-3.0/gtk.css
    gtk-4.0/settings.ini
    xfce4/terminal/terminalrc
    kitty/kitty.conf
    imv
    jgmenu/jgmenurc
    sigilo
    gtk-4.0/gtk.css
    skippy-xd/skippy-xd.rc
    cava
    # Sesión Hyprland: su configuración y la de su barra
    hypr
    waybar
    nwg-drawer/drawer.css
    # Unidades propias. Una a una y no la carpeta entera: en systemd/user
    # hay también cosas de otros programas que no pintan en el repositorio
    systemd/user/sigilo-apps-nuevas.path
    systemd/user/sigilo-apps-nuevas.service
)

# Lo que nunca entra: cachés, copias de seguridad y basura de git
EXCLUIR=(--exclude='.git' --exclude='*.bak' --exclude='*.bak-*' --exclude='*.viejo'
         --exclude='*.pre-fix' --exclude='*.plano' --exclude='*.log'
         --exclude='__pycache__' --exclude='*.sin-animaciones'
         # Lo que elige cada equipo por su cuenta: el fondo, el sello y si la
         # tarjeta de música está encendida. Si esto viajara, el sobremesa le
         # cambiaría el sello al portátil cada vez que instalase
         --exclude='fondo-actual' --exclude='sello-actual'
         --exclude='musica-escritorio-on')

echo "Sincronizando configuración -> repositorio"
for pieza in "${PIEZAS[@]}"; do
    src="$ORIGEN/$pieza"
    if [ ! -e "$src" ]; then
        printf '  %-34s (no existe, se omite)\n' "$pieza"
        continue
    fi
    dst="$DESTINO/$pieza"
    mkdir -p "$(dirname "$dst")"
    if [ -d "$src" ]; then
        rsync -a --delete "${EXCLUIR[@]}" "$src/" "$dst/"
    else
        cp -a "$src" "$dst"
    fi
    printf '  %-34s ok\n' "$pieza"
done

# ── accesos de aplicaciones propios (visor de imágenes…) ─────────────────
mkdir -p "$REPO/extra/aplicaciones"
cp -a "$HOME"/.local/share/applications/sigilo-*.desktop "$REPO/extra/aplicaciones/" 2>/dev/null \
    && printf '  %-34s ok\n' "aplicaciones (.desktop)"

# ── lista de paquetes ─────────────────────────────────────────────────────
# Cada equipo apunta los suyos en su propio fichero (paquetes/<equipo>-*.txt).
# Antes había una sola lista y el último equipo en sincronizar pisaba la del
# otro: el sobremesa borraba los drivers del portátil y al revés. Estas
# listas son solo para consultar qué hay en cada máquina; lo que instala
# Sigilo sale de iso/grupos.yaml.
EQUIPO=$(cat /etc/hostname 2>/dev/null || uname -n)
mkdir -p "$REPO/paquetes"
OFI="$REPO/paquetes/$EQUIPO-oficiales.txt"
AUR="$REPO/paquetes/$EQUIPO-aur.txt"
echo
echo "Anotando los paquetes instalados en «$EQUIPO»"
{
    echo "# Paquetes instalados en el equipo «$EQUIPO» (oficiales). Solo de referencia:"
    echo "# la lista que instala Sigilo es iso/grupos.yaml (extra/sigilo-apps)."
    pacman -Qqen 2>/dev/null
} > "$OFI"
{
    echo "# Paquetes instalados en el equipo «$EQUIPO» (aur). Solo de referencia:"
    echo "# la lista que instala Sigilo es iso/grupos.yaml (extra/sigilo-apps)."
    pacman -Qqem 2>/dev/null
} > "$AUR"
printf '  oficiales: %s\n  AUR:       %s\n' \
    "$(($(wc -l < "$OFI") - 2))" \
    "$(($(wc -l < "$AUR") - 2))"

echo
echo "Listo. Para guardar los cambios:"
echo "    cd $REPO && git add -A && git commit -m 'actualizar configuración'"
