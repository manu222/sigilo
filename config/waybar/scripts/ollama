#!/usr/bin/env bash
# Estado de Ollama para waybar, en JSON.
#   sin salida    el servicio no está en marcha (el módulo desaparece)
#   icono lila    en marcha, sin modelo en memoria
#   icono menta   hay un modelo cargado; el nombre sale al pasar el ratón
# Es el mismo que polybar/scripts/ollama.sh, pero waybar quiere JSON.

API=http://127.0.0.1:11434
ps=$(curl -s --max-time 1 $API/api/ps) || exit 0
[ -z "$ps" ] && exit 0

I=$'\U000f06a9'
nombre=$(printf '%s' "$ps" | grep -o '"name":"[^"]*"' | head -1 | cut -d'"' -f4)
if [ -n "$nombre" ]; then
    printf '{"text":"<span color=\\"#3ee8a8\\" size=\\"14pt\\" rise=\\"-1pt\\">%s</span>","tooltip":"Modelo en memoria: %s","class":"cargado"}\n' "$I" "$nombre"
else
    printf '{"text":"<span color=\\"#8f7fb0\\" size=\\"14pt\\" rise=\\"-1pt\\">%s</span>","tooltip":"Ollama listo, sin modelo cargado","class":"listo"}\n' "$I"
fi
