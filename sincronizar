#!/usr/bin/env bash
# Copia la configuración viva de ~/.config al repositorio.
#
# Se usan copias y no enlaces simbólicos a propósito: algunos programas
# (xfce4-terminal, btop) reescriben su fichero entero al guardar ajustes, y
# eso convierte un enlace en un fichero normal sin avisar. Con copias, el
# repositorio nunca se rompe solo; el precio es acordarse de ejecutar esto.

set -uo pipefail
REPO="$(cd "$(dirname "$0")" && pwd)"
ORIGEN="$HOME/.config"
DESTINO="$REPO/config"

# Qué se guarda. Rutas relativas a ~/.config
PIEZAS=(
    i3
    polybar
    rofi
    dunst/dunstrc
    picom.conf
    starship.toml
    sigilo-shell.sh
    fastfetch
    btop/btop.conf
    btop/themes
    bat/themes
    gtk-3.0/settings.ini
    gtk-3.0/gtk.css
    gtk-4.0/settings.ini
    xfce4/terminal/terminalrc
    kitty/kitty.conf
    imv
    jgmenu/jgmenurc
    sigilo
    gtk-4.0/gtk.css
    skippy-xd/skippy-xd.rc
    cava
    # Sesión Hyprland: su configuración y la de su barra
    hypr
    waybar
    nwg-drawer/drawer.css
    # Unidades propias. Una a una y no la carpeta entera: en systemd/user
    # hay también cosas de otros programas que no pintan en el repositorio
    systemd/user/sigilo-apps-nuevas.path
    systemd/user/sigilo-apps-nuevas.service
)

# Lo que nunca entra: cachés, copias de seguridad y basura de git
EXCLUIR=(--exclude='.git' --exclude='*.bak' --exclude='*.bak-*' --exclude='*.viejo'
         --exclude='*.pre-fix' --exclude='*.plano' --exclude='*.log'
         --exclude='__pycache__' --exclude='*.sin-animaciones'
         # Lo que elige cada equipo por su cuenta: el fondo, el sello y los
         # interruptores de la tarjeta de música. Si esto viajara, el
         # sobremesa le cambiaría el sello al portátil cada vez que instalase
         --exclude='fondo-actual' --exclude='sello-actual'
         --exclude='musica-escritorio-on' --exclude='musica-sin-barras'
         # Y lo que se dibuja a partir del sello de cada equipo. En el
         # repositorio se queda la versión del sello clásico, que es la que
         # ve quien instala esto por primera vez; si se recogieran, cada
         # equipo le pisaría al otro el banner y el dibujo del terminal
         --exclude='banner.png' --exclude='sello.rasi'
         --exclude='sigilo.png' --exclude='sigilo.ansi'
         --exclude='sello-bloqueo.png')

# ── que no subas configuración vieja por encima de la nueva ───────────────
# Esto copia ~/.config al repositorio. Si has hecho «git pull» y no has
# lanzado «./instalar.sh», lo que tienes en ~/.config es de ANTES del pull, y
# copiarlo ahora deshace en el repositorio lo que acabas de traerte. Pasó una
# vez y revirtió un arreglo entero sin que se notara: el commit decía
# «actualizar paquetes» y por dentro venía media configuración vieja.
MARCA="$HOME/.local/state/sigilo/instalado-commit.txt"
AHORA=$(git -C "$REPO" rev-parse HEAD 2>/dev/null)
if [ -f "$MARCA" ] && [ -n "$AHORA" ] && [ "$(cat "$MARCA")" != "$AHORA" ]; then
    echo
    echo "  Cuidado: este equipo tiene instalada otra versión del repositorio."
    echo "    instalado:  $(cut -c1-7 < "$MARCA")"
    echo "    repositorio: $(printf '%s' "$AHORA" | cut -c1-7)"
    echo
    echo "  Si sigues, tu ~/.config (que es el viejo) se copiará encima de lo"
    echo "  que hay en el repositorio y deshará esos cambios."
    echo "  Lo suyo es lanzar primero  ./instalar.sh  y luego esto."
    read -rp "  ¿Seguir de todas formas? [s/N] " r
    [[ "$r" =~ ^[sSyY]$ ]] || { echo "  Nada copiado."; exit 0; }
fi

echo "Sincronizando configuración -> repositorio"
for pieza in "${PIEZAS[@]}"; do
    src="$ORIGEN/$pieza"
    if [ ! -e "$src" ]; then
        printf '  %-34s (no existe, se omite)\n' "$pieza"
        continue
    fi
    dst="$DESTINO/$pieza"
    mkdir -p "$(dirname "$dst")"
    if [ -d "$src" ]; then
        rsync -a --delete "${EXCLUIR[@]}" "$src/" "$dst/"
    else
        cp -a "$src" "$dst"
    fi
    printf '  %-34s ok\n' "$pieza"
done

# ── accesos de aplicaciones propios (visor de imágenes…) ─────────────────
mkdir -p "$REPO/extra/aplicaciones"
# Se vuelve a poner la marca @CASA@ al guardarlos: instalar.sh la cambia por
# la carpeta de cada usuario, y si se subiera la ruta ya sustituida el
# repositorio se quedaría con la de este equipo
for d in "$HOME"/.local/share/applications/sigilo-*.desktop; do
    [ -e "$d" ] || continue
    sed "s|$HOME|@CASA@|g" "$d" > "$REPO/extra/aplicaciones/$(basename "$d")" \
        && printf '  %-34s ok\n' "$(basename "$d")"
done

# ── lista de paquetes ─────────────────────────────────────────────────────
# Cada equipo apunta los suyos en su propio fichero (paquetes/<equipo>-*.txt).
# Antes había una sola lista y el último equipo en sincronizar pisaba la del
# otro: el sobremesa borraba los drivers del portátil y al revés. Estas
# listas son solo para consultar qué hay en cada máquina; lo que instala
# Sigilo sale de iso/grupos.yaml.
EQUIPO=$(cat /etc/hostname 2>/dev/null || uname -n)
mkdir -p "$REPO/paquetes"
OFI="$REPO/paquetes/$EQUIPO-oficiales.txt"
AUR="$REPO/paquetes/$EQUIPO-aur.txt"
echo
echo "Anotando los paquetes instalados en «$EQUIPO»"
{
    echo "# Paquetes instalados en el equipo «$EQUIPO» (oficiales). Solo de referencia:"
    echo "# la lista que instala Sigilo es iso/grupos.yaml (extra/sigilo-apps)."
    pacman -Qqen 2>/dev/null
} > "$OFI"
{
    echo "# Paquetes instalados en el equipo «$EQUIPO» (aur). Solo de referencia:"
    echo "# la lista que instala Sigilo es iso/grupos.yaml (extra/sigilo-apps)."
    pacman -Qqem 2>/dev/null
} > "$AUR"
printf '  oficiales: %s\n  AUR:       %s\n' \
    "$(($(wc -l < "$OFI") - 2))" \
    "$(($(wc -l < "$AUR") - 2))"

echo
echo "Listo. Para guardar los cambios:"
echo "    cd $REPO && git add -A && git commit -m 'actualizar configuración'"
