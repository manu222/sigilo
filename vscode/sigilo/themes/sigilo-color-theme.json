// Tema Sigilo para VS Code.
//
// La misma paleta que el resto del escritorio (kitty, bat, GTK, la barra):
//   fondos      #0a0f0d  #0b100e  #0f1513  #15201c   (casi negro con tinte verde)
//   texto       #e7edea  apagado #94a3a0  más apagado #697f77 / #556760
//   menta       #34d399  #3ee8a8   → lo activo: cursor, pestaña, botones, funciones
//   lila        #c8aae5  #b79ad4  #9d8cc2, fondo lila #2c2342 / #1d1829
//               → la selección, las coincidencias, los enlaces y algún detalle
//   ámbar #c99d6b  cian #6fc9c0  azul #8aa9c4  rojo #e0777d
//
// Si cambias un color aquí, recarga VS Code (Ctrl+Shift+P → «Reload Window»).
// Para no reinstalar cada vez, puedes probar cambios en tu settings.json con
// "workbench.colorCustomizations" y pasarlos aquí cuando te gusten.
{
  "name": "Sigilo",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    // ── base ──────────────────────────────────────────────
    "foreground": "#e7edea",
    "descriptionForeground": "#94a3a0",
    "disabledForeground": "#556760",
    "errorForeground": "#e0777d",
    "focusBorder": "#34d39966",
    "contrastBorder": "#00000000",
    "widget.shadow": "#00000080",
    "selection.background": "#2c2342",
    "icon.foreground": "#94a3a0",
    "sash.hoverBorder": "#34d399",
    "textLink.foreground": "#c8aae5",
    "textLink.activeForeground": "#e0cdf2",
    "textBlockQuote.background": "#0f1513",
    "textBlockQuote.border": "#b79ad4",
    "textCodeBlock.background": "#0f1513",
    "textPreformat.foreground": "#8fd4b5",

    // ── barra de actividad (la columna de iconos de la izquierda) ──
    "activityBar.background": "#0a0f0d",
    "activityBar.foreground": "#3ee8a8",
    "activityBar.inactiveForeground": "#556760",
    "activityBar.border": "#15201c",
    "activityBar.activeBorder": "#34d399",
    "activityBar.activeBackground": "#0f1513",
    "activityBarBadge.background": "#b79ad4",
    "activityBarBadge.foreground": "#0a0f0d",

    // ── barra lateral y listas ──────────────────────────────
    "sideBar.background": "#0c1210",
    "sideBar.foreground": "#c9d3ce",
    "sideBar.border": "#15201c",
    "sideBarTitle.foreground": "#94a3a0",
    "sideBarSectionHeader.background": "#0c1210",
    "sideBarSectionHeader.foreground": "#94a3a0",
    "sideBarSectionHeader.border": "#15201c",
    "list.activeSelectionBackground": "#2c2342",
    "list.activeSelectionForeground": "#f2eefa",
    "list.inactiveSelectionBackground": "#1d1829",
    "list.inactiveSelectionForeground": "#e7edea",
    "list.hoverBackground": "#15201c",
    "list.hoverForeground": "#e7edea",
    "list.focusOutline": "#b79ad466",
    "list.focusBackground": "#2c2342",
    "list.highlightForeground": "#3ee8a8",
    "list.focusHighlightForeground": "#3ee8a8",
    "list.errorForeground": "#e0777d",
    "list.warningForeground": "#dcae76",
    "list.dropBackground": "#2c234280",
    "tree.indentGuidesStroke": "#1f2b27",
    "tree.inactiveIndentGuidesStroke": "#15201c",

    // ── pestañas y grupos de editores ───────────────────────
    "editorGroupHeader.tabsBackground": "#0b100e",
    "editorGroupHeader.tabsBorder": "#15201c",
    "editorGroup.border": "#15201c",
    "editorGroup.dropBackground": "#2c234240",
    "tab.activeBackground": "#0a0f0d",
    "tab.activeForeground": "#e7edea",
    "tab.activeBorderTop": "#34d399",
    "tab.activeBorder": "#0a0f0d",
    "tab.inactiveBackground": "#0b100e",
    "tab.inactiveForeground": "#70837c",
    "tab.hoverBackground": "#0f1513",
    "tab.border": "#0b100e",
    "tab.unfocusedActiveBorderTop": "#34d39955",
    "tab.activeModifiedBorder": "#c8aae5",
    "tab.inactiveModifiedBorder": "#b79ad466",
    "breadcrumb.foreground": "#70837c",
    "breadcrumb.focusForeground": "#e7edea",
    "breadcrumb.activeSelectionForeground": "#3ee8a8",
    "breadcrumbPicker.background": "#0f1513",

    // ── editor ─────────────────────────────────────────────
    "editor.background": "#0a0f0d",
    "editor.foreground": "#e7edea",
    "editorCursor.foreground": "#34d399",
    "editor.lineHighlightBackground": "#15201c80",
    "editor.lineHighlightBorder": "#00000000",
    "editorLineNumber.foreground": "#2f3d38",
    "editorLineNumber.activeForeground": "#3ee8a8",
    // Selección y coincidencias en lila: el detalle morado del tema
    "editor.selectionBackground": "#2c2342",
    "editor.selectionForeground": "#f2eefa",
    "editor.inactiveSelectionBackground": "#2c234299",
    "editor.selectionHighlightBackground": "#b79ad426",
    "editor.selectionHighlightBorder": "#b79ad455",
    "editor.wordHighlightBackground": "#b79ad41f",
    "editor.wordHighlightStrongBackground": "#b79ad433",
    "editor.findMatchBackground": "#b79ad455",
    "editor.findMatchBorder": "#c8aae5",
    "editor.findMatchHighlightBackground": "#b79ad426",
    "editor.findRangeHighlightBackground": "#2c234240",
    "editor.rangeHighlightBackground": "#15201c",
    "editor.hoverHighlightBackground": "#2c234255",
    "editorBracketMatch.background": "#2c234280",
    "editorBracketMatch.border": "#c8aae5",
    "editorWhitespace.foreground": "#1f2b27",
    "editorIndentGuide.background1": "#15201c",
    "editorIndentGuide.activeBackground1": "#3a2f55",
    "editorRuler.foreground": "#15201c",
    "editorCodeLens.foreground": "#556760",
    "editorLink.activeForeground": "#c8aae5",
    "editorInlayHint.foreground": "#9d8cc2",
    "editorInlayHint.background": "#1d182980",
    "editorGhostText.foreground": "#556760",
    "editorUnnecessaryCode.opacity": "#000000a0",
    // Paréntesis por niveles: menta, lila y cian
    "editorBracketHighlight.foreground1": "#34d399",
    "editorBracketHighlight.foreground2": "#c8aae5",
    "editorBracketHighlight.foreground3": "#6fc9c0",
    "editorBracketHighlight.foreground4": "#34d399",
    "editorBracketHighlight.foreground5": "#c8aae5",
    "editorBracketHighlight.foreground6": "#6fc9c0",
    "editorBracketHighlight.unexpectedBracket.foreground": "#e0777d",

    // ── avisos en el código ────────────────────────────────
    "editorError.foreground": "#e0777d",
    "editorWarning.foreground": "#dcae76",
    "editorInfo.foreground": "#6fc9c0",
    "editorHint.foreground": "#b79ad4",
    "problemsErrorIcon.foreground": "#e0777d",
    "problemsWarningIcon.foreground": "#dcae76",
    "problemsInfoIcon.foreground": "#6fc9c0",

    // ── margen izquierdo: cambios de git ────────────────────
    "editorGutter.background": "#0a0f0d",
    "editorGutter.addedBackground": "#34d399",
    "editorGutter.modifiedBackground": "#c99d6b",
    "editorGutter.deletedBackground": "#e0777d",
    "editorOverviewRuler.border": "#00000000",
    "editorOverviewRuler.findMatchForeground": "#b79ad4",
    "editorOverviewRuler.selectionHighlightForeground": "#b79ad488",
    "editorOverviewRuler.addedForeground": "#34d39999",
    "editorOverviewRuler.modifiedForeground": "#c99d6b99",
    "editorOverviewRuler.deletedForeground": "#e0777d99",
    "editorOverviewRuler.errorForeground": "#e0777d",
    "editorOverviewRuler.warningForeground": "#dcae76",

    // ── diff ───────────────────────────────────────────────
    "diffEditor.insertedTextBackground": "#34d3991f",
    "diffEditor.insertedLineBackground": "#34d39912",
    "diffEditor.removedTextBackground": "#e0777d26",
    "diffEditor.removedLineBackground": "#e0777d14",
    "diffEditor.diagonalFill": "#15201c",

    // ── colores de git en el explorador ────────────────────
    "gitDecoration.addedResourceForeground": "#3ee8a8",
    "gitDecoration.untrackedResourceForeground": "#3ee8a8",
    "gitDecoration.modifiedResourceForeground": "#dcae76",
    "gitDecoration.deletedResourceForeground": "#e0777d",
    "gitDecoration.renamedResourceForeground": "#6fc9c0",
    "gitDecoration.ignoredResourceForeground": "#556760",
    "gitDecoration.conflictingResourceForeground": "#c8aae5",
    "gitDecoration.stageModifiedResourceForeground": "#c99d6b",
    "gitDecoration.stageDeletedResourceForeground": "#e0777d",

    // ── ventanitas: autocompletado, buscar, sugerencias ────
    "editorWidget.background": "#0f1513",
    "editorWidget.foreground": "#e7edea",
    "editorWidget.border": "#1f2b27",
    "editorSuggestWidget.background": "#0f1513",
    "editorSuggestWidget.border": "#1f2b27",
    "editorSuggestWidget.foreground": "#c9d3ce",
    "editorSuggestWidget.selectedBackground": "#2c2342",
    "editorSuggestWidget.selectedForeground": "#f2eefa",
    "editorSuggestWidget.highlightForeground": "#3ee8a8",
    "editorSuggestWidget.focusHighlightForeground": "#3ee8a8",
    "editorHoverWidget.background": "#0f1513",
    "editorHoverWidget.border": "#1f2b27",
    "peekView.border": "#b79ad4",
    "peekViewTitle.background": "#0f1513",
    "peekViewTitleLabel.foreground": "#e7edea",
    "peekViewTitleDescription.foreground": "#94a3a0",
    "peekViewEditor.background": "#0b100e",
    "peekViewEditor.matchHighlightBackground": "#b79ad440",
    "peekViewResult.background": "#0c1210",
    "peekViewResult.selectionBackground": "#2c2342",
    "peekViewResult.matchHighlightBackground": "#b79ad440",
    "quickInput.background": "#0f1513",
    "quickInput.foreground": "#e7edea",
    "quickInputTitle.background": "#0b100e",
    "quickInputList.focusBackground": "#2c2342",
    "quickInputList.focusForeground": "#f2eefa",
    "pickerGroup.foreground": "#b79ad4",
    "pickerGroup.border": "#1f2b27",
    "commandCenter.background": "#0f1513",
    "commandCenter.border": "#1f2b27",
    "commandCenter.foreground": "#94a3a0",
    "commandCenter.activeBackground": "#15201c",

    // ── formularios, botones, menús ─────────────────────────
    "input.background": "#0f1513",
    "input.foreground": "#e7edea",
    "input.border": "#1f2b27",
    "input.placeholderForeground": "#556760",
    "inputOption.activeBorder": "#b79ad4",
    "inputOption.activeBackground": "#2c234280",
    "inputOption.activeForeground": "#f2eefa",
    "inputValidation.errorBackground": "#2a1417",
    "inputValidation.errorBorder": "#e0777d",
    "inputValidation.warningBackground": "#261d12",
    "inputValidation.warningBorder": "#dcae76",
    "inputValidation.infoBackground": "#0f1f1d",
    "inputValidation.infoBorder": "#6fc9c0",
    "dropdown.background": "#0f1513",
    "dropdown.border": "#1f2b27",
    "dropdown.foreground": "#e7edea",
    "dropdown.listBackground": "#0f1513",
    "checkbox.background": "#0f1513",
    "checkbox.border": "#1f2b27",
    "checkbox.foreground": "#3ee8a8",
    "button.background": "#34d399",
    "button.foreground": "#06130d",
    "button.hoverBackground": "#3ee8a8",
    "button.secondaryBackground": "#1d1829",
    "button.secondaryForeground": "#e0cdf2",
    "button.secondaryHoverBackground": "#2c2342",
    "badge.background": "#2c2342",
    "badge.foreground": "#e0cdf2",
    "progressBar.background": "#34d399",
    "menu.background": "#0f1513",
    "menu.foreground": "#e7edea",
    "menu.border": "#1f2b27",
    "menu.selectionBackground": "#2c2342",
    "menu.selectionForeground": "#f2eefa",
    "menu.separatorBackground": "#1f2b27",
    "menubar.selectionBackground": "#15201c",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#1f2b2766",
    "scrollbarSlider.hoverBackground": "#2c2342aa",
    "scrollbarSlider.activeBackground": "#b79ad466",
    "minimap.background": "#0a0f0d",
    "minimap.selectionHighlight": "#b79ad466",
    "minimap.findMatchHighlight": "#c8aae5",
    "minimapSlider.background": "#15201c66",
    "minimapSlider.hoverBackground": "#2c234266",

    // ── barra de título, panel y barra de estado ────────────
    "titleBar.activeBackground": "#0a0f0d",
    "titleBar.activeForeground": "#c9d3ce",
    "titleBar.inactiveBackground": "#0a0f0d",
    "titleBar.inactiveForeground": "#556760",
    "titleBar.border": "#15201c",
    "panel.background": "#0b100e",
    "panel.border": "#15201c",
    "panelTitle.activeForeground": "#e7edea",
    "panelTitle.activeBorder": "#34d399",
    "panelTitle.inactiveForeground": "#70837c",
    "panelInput.border": "#1f2b27",
    "statusBar.background": "#0a0f0d",
    "statusBar.foreground": "#94a3a0",
    "statusBar.border": "#15201c",
    "statusBar.noFolderBackground": "#0a0f0d",
    "statusBar.debuggingBackground": "#2c2342",
    "statusBar.debuggingForeground": "#f2eefa",
    "statusBarItem.hoverBackground": "#15201c",
    "statusBarItem.remoteBackground": "#1d1829",
    "statusBarItem.remoteForeground": "#c8aae5",
    "statusBarItem.prominentBackground": "#2c2342",
    "statusBarItem.errorBackground": "#c95f66",
    "statusBarItem.warningBackground": "#b8864f",
    "notifications.background": "#0f1513",
    "notifications.foreground": "#e7edea",
    "notifications.border": "#1f2b27",
    "notificationCenterHeader.background": "#0b100e",
    "notificationLink.foreground": "#c8aae5",
    "notificationsErrorIcon.foreground": "#e0777d",
    "notificationsWarningIcon.foreground": "#dcae76",
    "notificationsInfoIcon.foreground": "#6fc9c0",
    "welcomePage.tileBackground": "#0f1513",
    "welcomePage.tileHoverBackground": "#15201c",
    "walkThrough.embeddedEditorBackground": "#0b100e",
    "settings.headerForeground": "#e7edea",
    "settings.modifiedItemIndicator": "#b79ad4",
    "keybindingLabel.background": "#15201c",
    "keybindingLabel.foreground": "#e7edea",
    "keybindingLabel.border": "#1f2b27",
    "keybindingLabel.bottomBorder": "#1f2b27",
    "debugToolBar.background": "#0f1513",

    // ── terminal integrada: los mismos 16 colores que kitty ─
    "terminal.background": "#0a0f0d",
    "terminal.foreground": "#e7edea",
    "terminalCursor.foreground": "#34d399",
    "terminal.selectionBackground": "#2c2342",
    "terminal.border": "#15201c",
    "terminal.ansiBlack": "#15201c",
    "terminal.ansiBrightBlack": "#556760",
    "terminal.ansiRed": "#e0777d",
    "terminal.ansiBrightRed": "#f08b91",
    "terminal.ansiGreen": "#34d399",
    "terminal.ansiBrightGreen": "#3ee8a8",
    "terminal.ansiYellow": "#c99d6b",
    "terminal.ansiBrightYellow": "#dcae76",
    "terminal.ansiBlue": "#8aa9c4",
    "terminal.ansiBrightBlue": "#9bbad6",
    "terminal.ansiMagenta": "#b79ad4",
    "terminal.ansiBrightMagenta": "#c8aae5",
    "terminal.ansiCyan": "#6fc9c0",
    "terminal.ansiBrightCyan": "#7bdcd2",
    "terminal.ansiWhite": "#94a3a0",
    "terminal.ansiBrightWhite": "#e7edea"
  },

  // Colores del código. Son los mismos que el tema de bat, para que un
  // fichero se vea igual en la terminal y en el editor.
  "tokenColors": [
    { "name": "Comentarios", "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#697f77", "fontStyle": "italic" } },
    { "name": "Cadenas", "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": { "foreground": "#b8c9a0" } },
    { "name": "Interpolación dentro de cadenas (${…}, f-strings)",
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded", "meta.template.expression", "constant.character.format.placeholder"],
      "settings": { "foreground": "#c8aae5" } },
    { "name": "Expresiones regulares", "scope": ["string.regexp"],
      "settings": { "foreground": "#6fc9c0" } },
    { "name": "Números y constantes", "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#c99d6b" } },
    { "name": "Escapes", "scope": ["constant.character.escape"],
      "settings": { "foreground": "#6fc9c0" } },
    { "name": "Palabras clave", "scope": ["keyword", "keyword.control", "keyword.operator.logical", "keyword.operator.new", "keyword.operator.expression"],
      "settings": { "foreground": "#8aa9c4" } },
    { "name": "import, from, export: en lila", "scope": ["keyword.control.import", "keyword.control.from", "keyword.control.export", "keyword.other.import", "keyword.control.directive"],
      "settings": { "foreground": "#b79ad4" } },
    { "name": "Operadores", "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator", "punctuation.accessor"],
      "settings": { "foreground": "#7c8f87" } },
    { "name": "Almacenamiento (def, class, const…)", "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#7d97ae", "fontStyle": "italic" } },
    { "name": "Funciones", "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "#34d399" } },
    { "name": "Tipos y clases", "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"],
      "settings": { "foreground": "#8fd4b5" } },
    { "name": "Módulos y espacios de nombres", "scope": ["entity.name.namespace", "entity.name.module", "entity.name.type.module"],
      "settings": { "foreground": "#b79ad4" } },
    { "name": "Etiquetas HTML", "scope": ["entity.name.tag"],
      "settings": { "foreground": "#34d399" } },
    { "name": "Atributos", "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#c99d6b" } },
    { "name": "Variables", "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#e7edea" } },
    { "name": "Parámetros", "scope": ["variable.parameter"],
      "settings": { "foreground": "#c8d4d0" } },
    { "name": "self, this, super", "scope": ["variable.language"],
      "settings": { "foreground": "#b79ad4", "fontStyle": "italic" } },
    { "name": "Propiedades", "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property"],
      "settings": { "foreground": "#c9d3ce" } },
    { "name": "Claves de YAML, JSON y TOML", "scope": ["entity.name.tag.yaml", "support.type.property-name", "meta.mapping.key", "support.type.property-name.json", "support.type.property-name.toml"],
      "settings": { "foreground": "#34d399" } },
    { "name": "CSS: propiedades y valores", "scope": ["support.type.property-name.css", "support.constant.property-value.css"],
      "settings": { "foreground": "#8fd4b5" } },
    { "name": "Decoradores", "scope": ["entity.name.function.decorator", "meta.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#29a87a", "fontStyle": "italic" } },
    { "name": "Variables de shell ($HOME…)", "scope": ["variable.other.normal.shell", "punctuation.definition.variable.shell", "variable.other.special.shell"],
      "settings": { "foreground": "#c8aae5" } },
    { "name": "Errores", "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#e0777d" } },
    { "name": "Obsoleto", "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#dcae76" } },
    { "name": "Diff: añadido", "scope": ["markup.inserted"], "settings": { "foreground": "#34d399" } },
    { "name": "Diff: borrado", "scope": ["markup.deleted"], "settings": { "foreground": "#e0777d" } },
    { "name": "Diff: cambiado", "scope": ["markup.changed"], "settings": { "foreground": "#c99d6b" } },
    { "name": "Markdown: títulos", "scope": ["markup.heading", "entity.name.section", "punctuation.definition.heading"],
      "settings": { "foreground": "#3ee8a8", "fontStyle": "bold" } },
    { "name": "Markdown: enlaces", "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#c8aae5" } },
    { "name": "Markdown: código", "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
      "settings": { "foreground": "#8fd4b5" } },
    { "name": "Markdown: citas", "scope": ["markup.quote"],
      "settings": { "foreground": "#94a3a0", "fontStyle": "italic" } },
    { "name": "Negrita", "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "name": "Cursiva", "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } }
  ],

  // Resaltado semántico (lo que entiende el propio lenguaje, más fino que
  // los scopes de arriba). Mismo criterio de colores.
  "semanticTokenColors": {
    "namespace": "#b79ad4",
    "class": "#8fd4b5",
    "type": "#8fd4b5",
    "interface": "#8fd4b5",
    "enum": "#8fd4b5",
    "enumMember": "#c99d6b",
    "function": "#34d399",
    "method": "#34d399",
    "decorator": { "foreground": "#29a87a", "italic": true },
    "parameter": "#c8d4d0",
    "property": "#c9d3ce",
    "variable.readonly": "#c99d6b",
    "variable.defaultLibrary": "#8fd4b5",
    "selfParameter": { "foreground": "#b79ad4", "italic": true },
    "*.deprecated": { "strikethrough": true }
  }
}
