{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/home/manu/.config/fastfetch/sigilo.ansi",
    "width": 35,
    "height": 19,
    "padding": {
      "top": 1,
      "left": 1,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "green"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": " ",
      "keyColor": "green"
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "green"
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key": " ",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key": " ",
      "keyColor": "yellow"
    },
    {
      "type": "gpu",
      "key": " ",
      "keyColor": "magenta"
    },
    "break"
  ]
}
