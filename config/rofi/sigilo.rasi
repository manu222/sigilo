/* ─────────────────────────────────────────────────────────────
 * Rofi · lanzador de aplicaciones (❖+D y ❖+Espacio)
 *
 * Banner arriba con el sello, el buscador dentro del banner y debajo las
 * aplicaciones en rejilla de 3 columnas × 6 filas con icono grande.
 * El banner es rofi/banner.png: cámbialo por cualquier imagen ancha.
 * ───────────────────────────────────────────────────────────── */
/* Paleta Sigilo. Los mismos colores que la barra, las notificaciones y el
 * terminal: si cambias uno aquí, cámbialo también en polybar/config.ini. */
* {
    bg:        #070b09;
    bg-alt:    #0a0f0d;
    surface:   #15201c;
    raise:     #1b2723;
    line:      #26332e;
    fg:        #e7edea;
    fg-dim:    #94a3a0;
    fg-muted:  #70837c;
    accent:    #34d399;
    accent-hi: #3ee8a8;
    urgent:    #e0777d;

    background-color: transparent;
    text-color:       @fg-dim;
    font:             "JetBrainsMono Nerd Font 11";
}

/* Ventana centrada, con borde y esquinas redondeadas */
window {
    background-color: @bg;
    border:           1px;
    border-color:     @line;
    border-radius:    16px;
    width:            58em;
    padding:          0;
    location:         center;
    anchor:           center;
    transparency:     "real";
}

mainbox {
    children: [ "inputbar", "listview" ];
    spacing: 0;
    padding: 0;
}

/* ── banner + buscador ─────────────────────────────────────────────── */
inputbar {
    background-image: url("/home/manu/.config/rofi/banner.png", width);
    padding:  3.4em 2.2em 2.2em 2.2em;
    spacing:  0.7em;
    children: [ "prompt", "entry" ];
}

prompt {
    background-color: @bg-alt;
    text-color:       @accent-hi;
    padding:          0.75em 0.9em;
    border-radius:    10px;
    vertical-align:   0.5;
}

entry {
    background-color:  @bg-alt;
    text-color:        @fg;
    padding:           0.75em 1em;
    border-radius:     10px;
    placeholder:       "Buscar una aplicación...";
    placeholder-color: @fg-muted;
    cursor:            text;
    vertical-align:    0.5;
}

/* ── rejilla de aplicaciones ───────────────────────────────────────── */
/* Rejilla de apps: cambia columns y lines para ver más o menos a la vez */
listview {
    columns:      3;
    lines:        6;
    spacing:      0.4em;
    padding:      1.1em;
    fixed-height: true;
    cycle:        false;
    scrollbar:    false;
    dynamic:      true;
}

/* Cada app: icono y nombre */
element {
    padding:       0.6em 0.7em;
    spacing:       0.8em;
    border-radius: 10px;
    children:      [ "element-icon", "element-text" ];
}
element normal.normal, element alternate.normal { text-color: @fg-dim; }
element normal.urgent, element alternate.urgent { text-color: @urgent; }
/* App elegida con las flechas: se ilumina en menta */
element selected.normal {
    background-color: @surface;
    text-color:       @accent-hi;
}
element selected.urgent {
    background-color: @surface;
    text-color:       @urgent;
}

/* Tamaño del icono de cada app */
element-icon { size: 1.9em; vertical-align: 0.5; }
element-text { vertical-align: 0.5; }

message { padding: 0.5em 1.2em; }
textbox { text-color: @fg-muted; }
