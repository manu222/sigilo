#!/usr/bin/env bash
# Historial del portapapeles, pintado a mano para que no desentone: numero
# de orden, icono segun el tipo y el texto recortado.
#
# En i3 el historial lo guarda greenclip; en Hyprland, cliphist (lo arranca
# hypr/sigilo/arranque.lua). El menú es el mismo en las dos sesiones.
set -uo pipefail
. ~/.config/rofi/scripts/comun.sh
TEMA=~/.config/rofi/sigilo-lista.rasi

if en_hyprland; then
    command -v cliphist >/dev/null || {
        notify-send -u critical "Portapapeles" "Falta cliphist (sudo pacman -S cliphist)"; exit 1; }
    # cliphist da "id<TAB>texto"; el id hace falta para recuperar el original
    # completo (imágenes incluidas), el texto es solo para enseñarlo
    mapfile -t crudas < <(cliphist list)
    ids=(); entradas=()
    for c in "${crudas[@]}"; do
        ids+=("${c%%$'\t'*}")
        entradas+=("${c#*$'\t'}")
    done
else
    command -v greenclip >/dev/null || {
        notify-send -u critical "Portapapeles" "Falta greenclip (yay -S rofi-greenclip)"; exit 1; }
    mapfile -t entradas < <(greenclip print | grep -v '^[[:space:]]*$')
fi
if [ ${#entradas[@]} -eq 0 ]; then
    notify-send "Portapapeles" "El historial está vacío"; exit 0
fi

filas=""
n=0
for e in "${entradas[@]}"; do
    n=$((n+1))
    case "$e" in
        "[[ binary data"*)   ico="󰋩"; col="$VIOLET" ;;    # imagen (cliphist)
        http://*|https://*)  ico=""; col="$CYAN" ;;
        /*|~/*)              ico=""; col="$AMBER" ;;
        *@*.*)               ico=""; col="$VIOLET" ;;
        *)                   ico=""; col="$MUTE" ;;
    esac
    corto=$(printf '%s' "$e" | cut -c1-72 | esc)
    [ ${#e} -gt 72 ] && corto="$corto…"
    filas+="<span foreground=\"$MUTE\">$(printf '%2d' $n)</span>  <span foreground=\"$col\">$ico</span>  $corto|"
done

i=$(printf '%s' "${filas%|}" | rofi -dmenu -sep '|' -markup-rows -i -format i \
        -no-custom -theme "$TEMA" -p "portapapeles" \
        -mesg "<span foreground=\"$MUTE\">Intro lo copia al portapapeles   ·   escribe para buscar</span>")
[ -z "$i" ] && exit 0

if en_hyprland; then
    # Se recupera por su id: así vuelve tal cual, también si era una imagen
    printf '%s\t%s' "${ids[$i]}" "${entradas[$i]}" | cliphist decode | wl-copy
else
    printf '%s' "${entradas[$i]}" | xclip -selection clipboard
fi
notify-send -t 2500 "Portapapeles" "Copiado"
