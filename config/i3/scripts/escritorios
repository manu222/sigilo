#!/usr/bin/env python3
"""Escritorios para la barra, con el icono de lo que hay abierto en cada uno.

  1 󰈹   2 󰨞      3 󰉋

El escritorio activo va en su píldora menta; los demás, en gris. Si una
aplicación está repetida (tres terminales) sale un solo icono. Clic en un
escritorio para ir a él. Escucha los eventos de i3, así que no sondea.

Polybar no sabe encoger: si lo que pinta no cabe, se monta encima de lo de
la derecha. Por eso este bloque tiene un presupuesto de ancho y, si con
todos los iconos se pasa, los va quitando por escalones:
  1. número + iconos en todos
  2. iconos solo en el activo, número en el resto
  3. solo números
"""
import os, sys, time, i3ipc

# Clase de ventana (en minúsculas) -> icono de Nerd Font
ICONOS = {
    "firefox": 0xf0239, "brave-browser": 0xf059f, "chromium": 0xf059f,
    "google-chrome": 0xf02af,
    "kitty": 0xf018d, "xfce4-terminal": 0xf018d, "alacritty": 0xf018d,
    "code": 0xf0a1e, "code-oss": 0xf0a1e, "vscodium": 0xf0a1e,
    "thunar": 0xf024b, "nautilus": 0xf024b, "pcmanfm": 0xf024b,
    "claude": 0xf06c4, "com.anthropic.claude": 0xf06c4,
    "1password": 0xf030b, "seahorse": 0xf030b,
    "spotify": 0xf04c7, "vlc": 0xf057c, "mpv": 0xf0567,
    "discord": 0xf066f, "telegramdesktop": 0xf2c6, "telegram-desktop": 0xf2c6,
    "steam": 0xf04d3, "gimp": 0xf02e9, "ristretto": 0xf02e9, "feh": 0xf02e9,
    "evince": 0xf0226, "zathura": 0xf0226, "okular": 0xf0226,
    "libreoffice": 0xf0219, "soffice": 0xf0219, "mousepad": 0xf039e, "gedit": 0xf039e,
    "pavucontrol": 0xf057e, "blueman-manager": 0xf00af,
    "nm-connection-editor": 0xf0317, "timeshift-gtk": 0xf0493,
    "galculator": 0xf00ec, "thunderbird": 0xf01ee,
}
# Ventanas de terminal con un título conocido
TITULOS = {"btop": 0xf0127, "IA local": 0xf06a9, "Redes": 0xf0317}
GENERICO = 0xf08c6
MAX = 3

# Medidas en píxeles de lo que pinta polybar (fuentes del config)
CELDA = 8        # texto a 10 pt
ICONO = 12       # iconos (Nerd Font Mono a 15 pt)
TAPA = 22        # cada media luna de la píldora (27 pt)
# Lo que ocupa la derecha en el peor caso (IA, cable y 5 iconos en la
# bandeja) más el nombre de la aplicación y los márgenes.
RESERVA = 1360   # +90: el botón de aplicaciones a la izquierda

MENTA, OSCURO, GRIS, TENUE, ROJO, AMBAR, PILDORA = \
    "#34d399", "#06130d", "#556760", "#70837c", "#e0777d", "#c99d6b", "#15201c"
IZQ, DER = "", ""

i3 = i3ipc.Connection()
modo = "default"


def icono(v):
    """Icono de una ventana: por su título (btop, IA local…), por su clase o el genérico."""
    if v.name in TITULOS:
        return TITULOS[v.name]
    clase = (v.window_class or v.window_instance or "").lower()
    if clase in ICONOS:
        return ICONOS[clase]
    for k, g in ICONOS.items():          # com.algo.firefox, firefox-esr…
        if k in clase:
            return g
    return GENERICO


def iconos(ws):
    """Devuelve (texto, ancho en px) de los iconos de un escritorio."""
    vistos = []
    for v in ws.leaves():
        g = icono(v)
        if g not in vistos:
            vistos.append(g)
    if not vistos:
        return "", 0
    texto = " ".join(chr(g) for g in vistos[:MAX])
    ancho = len(vistos[:MAX]) * (ICONO + CELDA)
    if len(vistos) > MAX:
        extra = f" +{len(vistos) - MAX}"
        texto += extra
        ancho += len(extra) * CELDA
    return texto, ancho


def presupuesto(con=None):
    """Píxeles que puede ocupar este bloque: el ancho de la barra menos lo que usa la derecha."""
    try:
        activa = [o for o in (con or i3).get_outputs() if o.active]
        ancho = max(o.rect.width for o in activa)
    except Exception:
        ancho = 1920
    # Si suena música, la píldora de la barra ocupa sitio: lo apunta aquí
    try:
        musica = int(open(os.path.expanduser("~/.cache/sigilo-musica.ancho")).read())
    except (OSError, ValueError):
        musica = 0
    return int(ancho * 0.966) - RESERVA - musica


def pildora(color, frente, contenido):
    """Envuelve un texto en una píldora de color (media luna, fondo, media luna)."""
    return (f"%{{B-}}%{{F{color}}}%{{T3}}{IZQ}%{{T-}}%{{B{color}}}%{{F{frente}}}"
            f"{contenido}%{{B-}}%{{F{color}}}%{{T3}}{DER}%{{T-}}%{{F-}}")


def componer(lista, nivel):
    """nivel 1: iconos en todos · 2: solo en el activo · 3: ninguno."""
    partes, total = [], 0
    for w, num, (ics, ancho_ics) in lista:
        con_iconos = nivel == 1 or (nivel == 2 and w.focused)
        if not con_iconos:
            ics, ancho_ics = "", 0
        ics_fmt = f" %{{T4}}{ics}%{{T-}}" if ics else ""
        clic = f"%{{A1:i3-msg -q workspace {w.name}:}}"
        base = (len(num) + 2) * CELDA + ancho_ics
        if w.focused:
            cuerpo = pildora(MENTA, OSCURO, f" %{{T2}}{num}%{{T-}}{ics_fmt} ")
            total += base + 2 * TAPA
        elif w.urgent:
            cuerpo = pildora(ROJO, "#070b09", f" {num}{ics_fmt} ")
            total += base + 2 * TAPA
        else:
            cuerpo = f"%{{F{GRIS}}} {num}%{{F{TENUE}}}{ics_fmt} %{{F-}}"
            total += base
        partes.append(f"{clic}{cuerpo}%{{A}}")
    total += (len(partes) - 1) * CELDA
    return " ".join(partes), total


def pintar(*_, con=None):
    """Rehace la línea de escritorios y la escribe para la barra. Se llama en cada evento de i3."""
    c = con or i3
    arbol = {w.name: w for w in c.get_tree().workspaces()}
    lista = []
    for w in sorted(c.get_workspaces(), key=lambda w: (w.num if w.num >= 0 else 99, w.name)):
        nodo = arbol.get(w.name)
        num = w.name.split(":")[-1] if ":" in w.name else w.name
        lista.append((w, num, iconos(nodo) if nodo else ("", 0)))
    limite = presupuesto(c)
    for nivel in (1, 2, 3):
        texto, ancho = componer(lista, nivel)
        if ancho <= limite:
            break
    if modo != "default":
        texto += " " + pildora(AMBAR, "#070b09", f" {modo} ")
    print(texto, flush=True)


def al_cambiar_modo(_, e):
    """Guarda el modo de i3 (redimensionar…) para enseñarlo en ámbar al final."""
    global modo
    modo = e.change
    pintar()


for ev in (i3ipc.Event.WORKSPACE, i3ipc.Event.WINDOW_NEW, i3ipc.Event.WINDOW_CLOSE,
           i3ipc.Event.WINDOW_MOVE, i3ipc.Event.WINDOW_TITLE, i3ipc.Event.WINDOW_URGENT):
    i3.on(ev, pintar)
i3.on(i3ipc.Event.MODE, al_cambiar_modo)

def vigilar_musica():
    """Cuando aparece o desaparece la píldora de música cambia el sitio
    disponible, pero i3 no avisa de eso: se mira cada 2 s. Usa su propia
    conexión para no cruzarse con la del bucle de eventos."""
    import threading
    def bucle():
        propia = i3ipc.Connection()
        ruta = os.path.expanduser("~/.cache/sigilo-musica.ancho")
        antes = None
        while True:
            try:
                ahora = open(ruta).read()
            except OSError:
                ahora = ""
            if ahora != antes:
                antes = ahora
                pintar(con=propia)
            time.sleep(2)
    threading.Thread(target=bucle, daemon=True).start()


try:
    vigilar_musica()
    pintar()
    i3.main()
except (BrokenPipeError, KeyboardInterrupt):
    sys.exit(0)
