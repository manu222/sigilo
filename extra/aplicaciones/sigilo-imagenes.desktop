# Visor de imágenes de Sigilo (imv con las teclas de borrar y deshacer).
# Lo instala instalar.sh, que cambia @CASA@ por tu carpeta personal: los
# ficheros .desktop no entienden ~ ni $HOME, hay que escribir la ruta entera.
[Desktop Entry]
Type=Application
Name=Imágenes
GenericName=Visor de imágenes
Comment=Ver las imágenes de una carpeta y mandar a la papelera las que sobren
Exec=@CASA@/.config/i3/scripts/ver-imagenes %f
Icon=image-viewer
Terminal=false
Categories=Graphics;Viewer;
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/tiff;image/avif;image/heic;image/svg+xml;image/x-icon;
