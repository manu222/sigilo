#!/usr/bin/env python3
"""Píldora de música para la barra.

Mientras suena algo (Spotify, el navegador, VLC, mpv… cualquier cosa que
hable MPRIS), enseña una onda que se mueve con el sonido y el título de la
canción. En pausa, la onda se para y el título se apaga. Si no hay nada
abierto, la píldora desaparece.

  clic           pausa / sigue
  rueda          canción siguiente / anterior
  clic derecho   salta a la ventana del reproductor

El sonido sale de cava (config en ~/.config/cava/barra), que solo se
arranca mientras hay música. Además deja su ancho aproximado en
~/.cache/sigilo-musica.ancho para que los escritorios de la barra sepan
cuánto sitio les queda.
"""
import math, os, select, subprocess, sys, time

MAX_TITULO = 20
# Degradado de menta a lila, repartido a lo largo de la onda
COLORES = ["#34d399", "#4fd0a8", "#6bc9b8", "#86c0c8", "#9fb5d4", "#b3a9dc", "#c1a3e0", "#c8aae5"]
# La onda se dibuja con caracteres braille: cada uno son dos columnas de
# puntos por cuatro de alto, así que con diez caracteres salen veinte puntos
# de ancho, que ya se lee como una línea. Es la misma que en waybar.
# OJO: JetBrainsMono no trae braille; la fuente de repuesto está declarada
# en config.ini (font-4), porque polybar no busca ninguna por su cuenta.
CELDAS = 10
COLUMNAS = CELDAS * 2
FILAS = 4
BRAILLE = 0x2800
IZQUIERDA = (0x01, 0x02, 0x04, 0x40)     # bits de los puntos, de arriba abajo
DERECHA = (0x08, 0x10, 0x20, 0x80)
PILDORA, IZQ, DER = "#15201c", "", ""
ANCHO = os.path.expanduser("~/.cache/sigilo-musica.ancho")
CAVA_CONF = os.path.expanduser("~/.config/cava/barra")

# Nombre del reproductor en MPRIS -> clase de su ventana en i3
CLASES = {"spotify": "Spotify", "firefox": "firefox", "brave": "Brave-browser",
          "chromium": "Chromium", "vlc": "vlc", "mpv": "mpv"}


def fondo_actual():
    """Nombre del fichero que se está usando de fondo de pantalla, si lo hay."""
    try:
        with open(os.path.expanduser("~/.config/sigilo/fondo-actual")) as f:
            return os.path.basename(f.read().strip())
    except OSError:
        return ""


def es_el_fondo(nombre, titulo):
    """El fondo animado es un mpv más y, si lleva mpv-mpris cargado, se
    anuncia como si fuera música. Se descarta comparándolo con el fichero
    que está puesto de fondo."""
    return nombre.lower().startswith("mpv") and titulo and titulo == fondo_actual()


def reproductor():
    """(nombre, estado, artista, título) del reproductor que suena, o del
    que está en pausa si no suena ninguno. None si no hay ninguno."""
    try:
        r = subprocess.run(["playerctl", "-a", "metadata", "--format",
                            "{{playerName}}\t{{status}}\t{{artist}}\t{{title}}"],
                           capture_output=True, text=True, timeout=2)
    except (OSError, subprocess.TimeoutExpired):
        return None
    filas = [l.split("\t") for l in r.stdout.splitlines() if l.count("\t") == 3]
    filas = [f for f in filas if not es_el_fondo(f[0], f[3])]
    for estado in ("Playing", "Paused"):
        for f in filas:
            if f[1] == estado:
                return f
    return None


def limpio(t):
    """Texto seguro para polybar: sin etiquetas %{…} y recortado."""
    t = t.replace("%{", "% {").strip()
    return t if len(t) <= MAX_TITULO else t[:MAX_TITULO - 1] + "…"


def pildora(nombre, contenido):
    base = nombre.split(".")[0]
    clase = CLASES.get(base, base)
    acciones = (f"%{{A1:playerctl -p {nombre} play-pause:}}"
                f"%{{A4:playerctl -p {nombre} next:}}%{{A5:playerctl -p {nombre} previous:}}"
                f"%{{A3:i3-msg -q [class=\"(?i){clase}\"] focus:}}")
    return (f"{acciones}%{{B-}}%{{F{PILDORA}}}%{{T3}}{IZQ}%{{T-}}%{{B{PILDORA}}}%{{F-}} "
            f"{contenido} %{{B-}}%{{F{PILDORA}}}%{{T3}}{DER}%{{T-}}%{{F-}}%{{A}}%{{A}}%{{A}}%{{A}} ")


def onda(valores, fase):
    """La onda de la píldora: una línea que se ondula siempre en el mismo
    sitio y a la que la música le sube y le baja la altura en cada tramo.

    A cada punto de la línea le toca una banda de cava (las ocho, repartidas
    e interpoladas para que no haya escalones), y la onda entera se infla con
    los graves, que es lo que marca el ritmo. El vaivén lo pone el seno, que
    va avanzando con «fase»."""
    graves = (valores[0] + valores[1]) / 14.0
    celdas = []
    for c in range(CELDAS):
        marca = 0
        for lado, bits in ((0, IZQUIERDA), (1, DERECHA)):
            t = (c * 2 + lado) / (COLUMNAS - 1)
            p = t * (len(valores) - 1)
            a = int(p)
            b = min(len(valores) - 1, a + 1)
            nivel = (valores[a] + (valores[b] - valores[a]) * (p - a)) / 7.0
            # los extremos se van apagando para que no acabe de golpe
            borde = math.sin(math.pi * t) ** 0.35
            altura = (math.sin(t * math.pi * 2.5 - fase) * 0.7 +
                      math.sin(t * math.pi * 4.5 + fase * 1.6) * 0.3)
            fila = round(1.6 - altura * (0.08 + (nivel * 0.4 + graves * 0.9) * 2.8) * borde)
            marca |= bits[min(max(fila, 0), FILAS - 1)]
        celdas.append(chr(BRAILLE + marca))
    return "".join("%%{F%s}%s" % (COLORES[i * len(COLORES) // CELDAS], ch)
                   for i, ch in enumerate(celdas)) + "%{F-}"


def apuntar_ancho(px):
    try:
        if px:
            open(ANCHO, "w").write(str(px))
        elif os.path.exists(ANCHO):
            os.remove(ANCHO)
    except OSError:
        pass


def main():
    cava = None
    ultimo_repaso = 0
    info = None
    valores = [0] * 8
    fase = 0.0
    ultimo_marco = time.time()
    while True:
        ahora = time.time()
        # La onda avanza por tiempo, no por fotograma, para que se mueva igual
        # de rápido dé cava lo que dé; y con lo fuerte que suene, un poco más
        paso = min(0.2, ahora - ultimo_marco)
        ultimo_marco = ahora
        fase += paso * (2.2 + 3.0 * (sum(valores) / (7.0 * len(valores))))
        if ahora - ultimo_repaso > 1:            # el reproductor se mira una vez por segundo
            info = reproductor()
            ultimo_repaso = ahora
            sonando = info is not None and info[1] == "Playing"
            if sonando and cava is None:
                cava = subprocess.Popen(["cava", "-p", CAVA_CONF], stdout=subprocess.PIPE,
                                        stderr=subprocess.DEVNULL, text=True, bufsize=1)
            elif not sonando and cava is not None:
                cava.terminate(); cava = None
                valores = [0] * 8

        if info is None:
            print("", flush=True); apuntar_ancho(0)
            time.sleep(1); continue

        nombre, estado, artista, titulo = info
        texto = limpio(f"{titulo} · {artista}" if artista else titulo)
        if cava is not None:
            listo, _, _ = select.select([cava.stdout], [], [], 0.2)
            if listo:
                linea = cava.stdout.readline()
                try:
                    valores = [int(x) for x in linea.strip().strip(";").split(";")][:8]
                except ValueError:
                    pass
            contenido = f"{onda(valores, fase)}  %{{F#c9d3ce}}{texto}%{{F-}}"
        else:
            contenido = f"%{{F#70837c}}%{{T4}}\U000f03e4%{{T-}}  {texto}%{{F-}}"
            time.sleep(0.5)
        print(pildora(nombre, contenido), flush=True)
        # la onda + separación + texto, a 8 px por carácter, más las tapas
        apuntar_ancho(8 * (CELDAS + 3 + len(texto)) + 60)


if __name__ == "__main__":
    try:
        main()
    except (BrokenPipeError, KeyboardInterrupt):
        apuntar_ancho(0)
