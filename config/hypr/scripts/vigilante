#!/usr/bin/env bash
# Red de seguridad mientras se prueba Hyprland en un equipo nuevo.
#
# Cada 3 segundos le pregunta a Hyprland si sigue vivo. Si deja de
# contestar tres veces seguidas (la pantalla se ha quedado congelada),
# guarda su registro en ~/.cache/hyprland-congelado.log y lo cierra a la
# fuerza, para volver a lightdm sin tener que reiniciar el equipo.
#
# Además va copiando el registro a ~/.cache/hyprland-ultimo.log, porque el
# original vive en /run/user, que se borra al reiniciar.
#
# Modo prueba: si la imagen se congela pero Hyprland sigue contestando
# (lo que pasó en el sobremesa al entrar desde lightdm), eso no se puede
# detectar desde fuera. Por eso, mientras exista ~/.config/hypr/prueba, la sesión se cierra sola a
# los 45 segundos salvo que confirmes que funciona con Super+Alt+Intro.
# Si ves la pantalla bien, pulsas eso y te quedas; si está congelada, no
# haces nada y en 45 s vuelves a lightdm.
#
# Se quita de sigilo/arranque.lua cuando Hyprland vaya fino en el equipo.

REG="${XDG_RUNTIME_DIR}/hypr/${HYPRLAND_INSTANCE_SIGNATURE}/hyprland.log"
DEST="${XDG_CACHE_HOME:-$HOME/.cache}"
mkdir -p "$DEST"
fallos=0
PRUEBA="$HOME/.config/hypr/prueba"
OK="${XDG_RUNTIME_DIR}/hypr-prueba-ok"
rm -f "$OK"
inicio=$(date +%s)

while pgrep -x Hyprland >/dev/null; do
    sleep 3
    cp -f "$REG" "$DEST/hyprland-ultimo.log" 2>/dev/null
    if [ -e "$PRUEBA" ] && [ ! -e "$OK" ] && [ $(( $(date +%s) - inicio )) -ge 45 ]; then
        echo "=== $(date '+%F %T') modo prueba: nadie confirmó en 45 s, se cierra" > "$DEST/hyprland-congelado.log"
        cat "$REG" >> "$DEST/hyprland-congelado.log" 2>/dev/null
        pkill -KILL -x Hyprland
        exit 0
    fi
    if timeout 2 hyprctl version >/dev/null 2>&1; then
        fallos=0
        continue
    fi
    fallos=$((fallos + 1))
    if [ "$fallos" -ge 3 ]; then
        {
            echo "=== $(date '+%F %T') Hyprland no contesta: se cierra a la fuerza"
            cat "$REG" 2>/dev/null
            echo
            echo "=== mensajes del núcleo (driver de la gráfica)"
            journalctl -k -b --since "-5min" --no-pager 2>/dev/null | tail -60
        } > "$DEST/hyprland-congelado.log"
        pkill -KILL -x Hyprland
        exit 0
    fi
done
