#!/usr/bin/env python3
"""Chuleta de atajos, pintada a mano en el terminal.

Se genera leyendo los atajos de verdad, asi que no se queda desfasada:
  · en i3, del fichero ~/.config/i3/config
  · en Hyprland, de «hyprctl binds», con la descripción que lleva cada
    atajo en ~/.config/hypr/sigilo/atajos.lua
Se abre en una ventana flotante y centrada con Super+F1.
"""
import html, json, os, re, shutil, subprocess, sys

HYPRLAND = bool(os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"))

CFG = os.environ.get("I3CFG", os.path.expanduser("~/.config/i3/config"))

# ── paleta Sigilo ───────────────────────────────────────────────────────────
BG      = (10, 15, 13)
FG      = (231, 237, 234)
DIM     = (148, 163, 160)
MUTE    = (112, 131, 124)
LINE    = (38, 51, 46)
MINT    = (62, 232, 168)
CYAN    = (111, 201, 192)
SLATE   = (138, 169, 196)
VIOLET  = (183, 154, 212)
AMBER   = (201, 157, 107)
OLIVE   = (184, 201, 160)
RED     = (224, 119, 125)
OSCURO  = (6, 19, 13)

COLORES = [MINT, AMBER, SLATE, VIOLET, CYAN, OLIVE, RED]

def f(c):  return "\x1b[38;2;%d;%d;%dm" % c
def b(c):  return "\x1b[48;2;%d;%d;%dm" % c
RST = "\x1b[0m"
BOLD = "\x1b[1m"

# ── fuente de bloques 5x7 para el titulo ────────────────────────────────────
FUENTE = {
 "A": ["01110","10001","10001","11111","10001","10001","10001"],
 "T": ["11111","00100","00100","00100","00100","00100","00100"],
 "J": ["00111","00010","00010","00010","10010","10010","01100"],
 "O": ["01110","10001","10001","10001","10001","10001","01110"],
 "S": ["01111","10000","10000","01110","00001","00001","11110"],
 " ": ["00000"]*7,
}

def titulo(texto):
    """Pinta un texto con letras de bloques de 5×7, con degradado de menta a turquesa."""
    filas = []
    for r in range(7):
        linea = ""
        for ch in texto:
            pat = FUENTE.get(ch, FUENTE[" "])[r]
            linea += "".join("██" if p == "1" else "  " for p in pat) + "  "
        filas.append(linea.rstrip())
    ancho = max(len(x) for x in filas)
    out = []
    for i, linea in enumerate(filas):
        # degradado de menta a cian de arriba abajo
        t = i / 6
        c = tuple(int(MINT[k]*(1-t) + CYAN[k]*t) for k in range(3))
        out.append(f(c) + BOLD + linea + RST)
    return out, ancho

